        "required": false
      },
      {
        "possibility_id": "mediation_opening",
        "condition": "safe_conduct_and_witnesses_remain_available",
        "may_change": ["relationship_state", "clock_progress"],
        "status": "conditional",
        "required": false
      },
      {
        "possibility_id": "resource_exchange",
        "condition": "a_faction_exposes_usable_information_or_access",
        "may_change": ["water_access", "trade_access", "support_shift"],
        "status": "conditional",
        "required": false
      }
    ],
    "continuity": [
      {
        "constraint_id": "clock_state_persists",
        "requirement": "clock_values_carry_between_sessions",
        "preserve": true
      },
      {
        "constraint_id": "faction_motives_persist",
        "requirement": "faction_agendas_remain_actor_driven_until_changed_in_play",
        "preserve": true
      },
      {
        "constraint_id": "information_visibility_persists",
        "requirement": "restricted_information_does_not_become_public_without_a_reveal_event",
        "preserve": true
      },
      {
        "constraint_id": "player_changes_persist",
        "requirement": "accepted_player_caused_state_changes_remain_observable",
        "preserve": true
