        "trigger": "dry-season-demand",
        "effect_class": "resource_scarcity"
      },
      {
        "pressure_id": "trade_access",
        "source": "river_crossing",
        "target": ["ridge_compact", "free_caravan_league"],
        "persistent": true,
        "trigger": "patrol_or_permit_change",
        "effect_class": "route_disruption"
      },
      {
        "pressure_id": "legitimacy",
        "source": "neutral_market",
        "target": ["river_council", "ridge_compact"],
        "persistent": true,
        "trigger": "public_breach_or_witness_loss",
        "effect_class": "support_shift"
      }
    ],
    "player_owned_decisions": [
      {
        "decision_id": "alignment_surface",
        "owner": "players",
        "decision_scope": "which_interests_to_support_or_balance",
        "required": false,
        "options_open": true,
        "response_classes": ["engagement", "negotiation", "investigation", "avoidance", "redirection", "refusal", "unexpected_approach"]
      },
      {
        "decision_id": "pressure_response_surface",
        "owner": "players",
        "decision_scope": "whether_and_how_to_change_a_live_pressure",
        "required": false,
        "options_open": true,
        "response_classes": ["direct_action", "indirect_action", "information_exchange", "non_intervention"]
      }
    ],
    "open_outcomes": [
      {
        "outcome_id": "regional_control",
        "owner": "players_and_world",
        "state": "open",
        "possible_state_classes": ["shared_access", "council_control", "compact_control", "route_fragmentation", "negotiated_stability"]
      },
      {
        "outcome_id": "faction_relationships",
        "owner": "players_and_world",
        "state": "open",
        "possible_state_classes": ["alliance", "rivalry", "conditional_cooperation", "withdrawal"]
      }
    ],
    "conditional_possibilities": [
      {
        "possibility_id": "lockdown_escalation",
        "condition": "crossing_lockdown_reaches_threshold",
