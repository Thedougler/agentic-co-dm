        "next_options_open": true
      },
      {
        "response": "negotiation",
        "playable_result": "terms can be proposed, accepted, rejected, or revised according to faction interests",
        "state_effect": "standing and access may change when a term is honored, contested, or witnessed",
        "next_options_open": true
      },
      {
        "response": "investigation",
        "playable_result": "the party can test competing accounts and uncover information without guaranteeing agreement",
