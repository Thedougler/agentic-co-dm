{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false
  },
  "globs": [
    "**/*.md",
    "!wiki/_raw/**/*.md",
    "!wiki/_staging/**/*.md",
    "!wiki/_archive/**/*.md",
    "!wiki/templates/**/*.md",
    "!node_modules/**/*.md",
    "!specs/**/*.md"
  ]
}
