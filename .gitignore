# OS
.DS_Store
**/.DS_Store
Thumbs.db
*.tmp
*.swp
*.log
.vscode/
.idea/


# Secrets / machine paths
.env
.env.*
!.env.example
mcp.json
foundry-data/
foundry-data

# Spec Kit local
.specify/presets/.registry

# Obsidian — local UI state (keep shared app/appearance)
wiki/.obsidian/workspace.json
wiki/.obsidian/workspace-mobile.json
wiki/.obsidian/workspaces.json
wiki/.obsidian/graph.json
wiki/.obsidian/cache/
wiki/.obsidian/plugins/*/data.json
wiki/.obsidian/*.bak
wiki/.obsidian/*.backup-*
wiki/.trash/

# qmd local indexes
**/.qmd/*.sqlite
**/.qmd/*.sqlite-*
**/.qmd/refresh.*

# Harness copies of pipx wiki skills (absolute machine symlinks)
.claude/skills/*
!.claude/skills/speckit-*/
.cursor/skills/
.kiro/skills/
.pi/skills/
.windsurf/skills/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
dist/

# Legacy archive — retain Markdown and WebP only.
# .gitignore cannot enforce a WebP size limit; keep those assets lightweight.
legacy/**
!legacy/**/
!legacy/**/*.md
!legacy/**/*.webp
