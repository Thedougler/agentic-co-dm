#!/usr/bin/env python3
"""Structural wiki lint plus the creative-lint rule engine.

Invocations without a creative subcommand delegate unchanged to
``tools/lint_wiki.py``. Creative commands are ``task``, ``file``, ``corpus``,
``changed``, ``rule``, and ``candidate``.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
LINT = ROOT / "tools" / "lint_wiki.py"
CREATIVE_COMMANDS = {"task", "file", "corpus", "changed", "rule", "candidate", "queue", "template"}
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))


def run_lint(vault: Path, extra: list[str]) -> tuple[int, dict]:
    cmd = [sys.executable, str(LINT), "--json", str(vault), *extra]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr or f"lint_wiki.py exited {proc.returncode}\n")
        raise SystemExit(proc.returncode)
    if not proc.stdout.strip():
        raise SystemExit("lint_wiki.py produced no JSON")
    return proc.returncode, json.loads(proc.stdout)


def structural_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("vault", nargs="?", default="wiki")
    parser.add_argument("--vault", dest="vault_override")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--scope")
    parser.add_argument("--template", action="store_true")
    parser.add_argument("--plan", action="store_true")
    parser.add_argument("--from", dest="findings_file")
    parser.add_argument("--hard", action="store_true", default=True)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--allow-lifecycle", action="append", default=[])
    parser.add_argument("--allow-relationship-type", action="append", default=[])
    args = parser.parse_args(argv)
    vault = Path(args.vault_override or args.vault).expanduser().resolve()
    try:
        from tools.wiki_ops.scope import parse_scope
        scope = parse_scope(args.scope)
        if scope:
            scope.resolve(vault)
        identities = []
        if scope:
            from tools.wiki_ops.identity import scan_identities
            identities = scan_identities(vault, scope=scope)
        ambiguous_identities = [item.to_dict() for item in identities if item.status == "ambiguous"]
        if not args.all:
            extra.append("--hard-only")
        for value in args.allow_lifecycle:
            extra.extend(["--allow-lifecycle", value])
        for value in args.allow_relationship_type:
            extra.extend(["--allow-relationship-type", value])
        if scope:
            extra.extend(["--scope", args.scope])
        source = json.loads(Path(args.findings_file).read_text(encoding="utf-8")) if args.findings_file else None
        if source is None:
            code, report = run_lint(vault, extra)
        else:
            code, report = 0, source
        report["identity"] = {"status": "ambiguous" if ambiguous_identities else "resolved", "ambiguous": ambiguous_identities, "scanned": len(identities)}
        if ambiguous_identities:
            report["identity_ambiguous"] = True
        if args.template:
            from tools.wiki_ops.template_contracts import check_conformance, load_contract
            paths = scope.resolved_files if scope else [p.relative_to(vault).as_posix() for p in vault.rglob("*.md") if p.is_file()]
            template_findings = []
            exemptions = 0
            for relative in paths:
                page = vault / relative
                try:
                    fields = __import__("tools.wiki_ops.mutations", fromlist=["frontmatter_fields"]).frontmatter_fields(page.read_text(encoding="utf-8"))
                    contract_path = vault / "templates" / "contracts" / f"{fields.get('type', '')}.yml"
                    if not contract_path.is_file():
                        contract_path = ROOT / "wiki" / "templates" / "contracts" / f"{fields.get('type', '')}.yml"
                    if contract_path.is_file():
                        template_findings.extend(check_conformance(relative, page.read_text(encoding="utf-8"), load_contract(contract_path)))
                except (OSError, ValueError) as exc:
                    template_findings.append({"rule_id": "TMPL_error", "file": relative, "severity": "BLOCK", "reason": str(exc)})
            report.setdefault("findings", {})
            report["findings"]["template"] = template_findings
            report.setdefault("counts", {})
            report["counts"]["template"] = len(template_findings)
            report["template_used"] = str(contract_path) if 'contract_path' in locals() and contract_path.is_file() else None
        if args.plan:
            findings = report.get("findings", {})
            if isinstance(findings, dict):
                flat = []
                for rule, items in findings.items():
                    if isinstance(items, list):
                        for item in items:
                            if isinstance(item, dict) and item.get("repair_class") == "deterministic_repair" and item.get("repair_action"):
                                flat.append({"finding_rule": rule, "finding_file": item.get("page") or item.get("file"), "finding_line": item.get("line"), "mutation": item["repair_action"]})
                report = {"scope": report.get("scope", scope.to_dict() if scope else {}), "source_findings": sum(int(v) for v in (report.get("counts") or {}).values() if isinstance(v, int)), "deterministic_actions": len(flat), "human_only": 0, "diagnostic_only": 0, "actions": flat}
        if scope:
            report["scope"] = scope.to_dict()
            report["files_checked"] = len(scope.resolved_files)
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print(json.dumps(report, indent=2, sort_keys=True))
        if ambiguous_identities:
            return 2
        if args.plan:
            return 2 if report.get("actions") else 0
        return 1 if (args.all and any((report.get("counts") or {}).values())) or (not args.all and report.get("hard_fail")) else 0
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2


def _paths(values: list[str], *, default: Path) -> list[Path]:
    return [Path(value) for value in values] if values else [default]


def _severity(value: str | None) -> set[str] | None:
    if not value:
        return None
    allowed = {"BLOCK", "REPAIR", "REVIEW", "WARN", "INFO"}
    result = {item.strip().upper() for item in value.split(",") if item.strip()}
    invalid = result - allowed
    if invalid:
        raise ValueError(f"unknown severity: {', '.join(sorted(invalid))}")
    return result


def _load_engine():
    from tools.creative_lint.bundles import BundleRegistry
    from tools.creative_lint.engine import LintEngine
    from tools.creative_lint.registry import Registry
    from tools.creative_lint.waivers import WaiverRegistry
    registry = Registry.load(ROOT / "rules" / "registry.yml")
    bundles = BundleRegistry.load(ROOT / "rules" / "bundles.yml")
    waivers = WaiverRegistry.load(ROOT / "rules" / "waivers.json")
    return LintEngine(registry, bundles, root=ROOT, vault=ROOT / "wiki", waivers=waivers), registry, bundles


def _exit_for(result) -> int:
    return {"repair_required": 1, "review_needed": 2, "clean": 0}[result.status]


def _snapshot(vault: Path, report: dict[str, Any]) -> str:
    digest = hashlib.sha256()
    digest.update(json.dumps(report, sort_keys=True, separators=(",", ":")).encode())
    if vault.is_dir():
        for path in sorted(vault.rglob("*.md")):
            if any(part in {".obsidian", "_archive", "_archives", "_raw", "_readouts", "_staging", "_meta", "templates"} for part in path.relative_to(vault).parts):
                continue
            digest.update(path.relative_to(vault).as_posix().encode())
            digest.update(path.read_bytes())
    return "sha256:" + digest.hexdigest()


def consolidate_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="wiki-lint --consolidate")
    parser.add_argument("vault", nargs="?", default="wiki")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--approve", action="store_true")
    args = parser.parse_args(argv)
    vault = Path(args.vault)
    if not vault.is_absolute():
        vault = (Path.cwd() / vault).resolve()
    if not vault.is_dir():
        print(f"wiki-lint: vault not found: {vault}", file=sys.stderr)
        return 2
    try:
        _, report = run_lint(vault, ["--hard-only"])
    except (SystemExit, json.JSONDecodeError) as exc:
        print(f"wiki-lint: unable to build consolidation plan: {exc}", file=sys.stderr)
        return 2
    # Structural findings do not contain enough information to safely invent
    # canon or judgment repairs. The initial safe plan is therefore empty;
    # future deterministic repair kinds may be added without changing schema.
    plan = {
        "vault": str(vault),
        "snapshot": _snapshot(vault, report),
        "actions": [],
        "requires_approval": True,
        "approved": bool(args.approve),
    }
    result = {"status": "applied" if args.approve else "dry_run", "plan": plan}
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"wiki-lint --consolidate: {result['status']} ({len(plan['actions'])} safe actions)")
    return 0


def creative_main(argv: list[str]) -> int:
    from tools.creative_lint.cli_output import render_human, render_queue
    from tools.creative_lint.template_profile import template_conformance
    from tools.creative_lint.engine import LintResult
    command = argv[0] if argv else ""
    try:
        engine, registry, bundles = _load_engine()
    except (OSError, ValueError, KeyError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2
    if command == "rule":
        parser = argparse.ArgumentParser(prog="wiki-lint rule")
        parser.add_argument("rule_id")
        args = parser.parse_args(argv[1:])
        try:
            rule = registry.get(args.rule_id)
        except KeyError:
            print(f"Unknown rule ID: {args.rule_id}", file=sys.stderr)
            return 2
        print(f"{rule.id}: {rule.title}")
        print(f"Category:  {rule.category}")
        print(f"Severity:  {rule.severity}")
        print(f"Evaluator: {rule.evaluator}")
        print(f"Lifecycle: {rule.lifecycle}")
        print(f"Scope:     {rule.scope}")
        print(f"Message:   {rule.message}")
        print(f"Repair:    {rule.repair or 'none'}")
        print(f"Tags:      {', '.join(rule.tags) or 'none'}")
        memberships = []
        for name in bundles.available():
            bundle = bundles.get(name)
            for gate in ("block", "review", "diagnostics"):
                if rule.category in (getattr(bundle, gate) or []):
                    memberships.append(f"{name} ({gate})")
        print(f"Bundles:   {', '.join(memberships) or 'none'}")
        return 0
    if command == "candidate":
        return candidate_main(argv[1:], registry)
    if command == "queue":
        parser = argparse.ArgumentParser(prog="wiki-lint queue")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        try:
            data = engine.dirty_queue()
        except (ValueError, KeyError) as exc:
            print(f"wiki-lint: {exc}", file=sys.stderr)
            return 2
        print(json.dumps(data, indent=2, sort_keys=True) if args.json else render_queue(data))
        return 0
    if command == "template":
        parser = argparse.ArgumentParser(prog="wiki-lint template")
        parser.add_argument("path")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        page = Path(args.path)
        if not page.is_absolute():
            page = (ROOT / page).resolve()
        if not page.is_file():
            print(f"wiki-lint: page not found: {page}", file=sys.stderr)
            return 2
        try:
            selected, findings = template_conformance(page, root=ROOT)
        except (OSError, ValueError) as exc:
            print(f"wiki-lint: {exc}", file=sys.stderr)
            return 2
        if selected is None:
            print(f"wiki-lint: no template resolved for {page}", file=sys.stderr)
            return 2
        def display_path(path: Path) -> str:
            try:
                return str(path.relative_to(ROOT))
            except ValueError:
                return str(path)
        payload = {"template": display_path(selected), "page": display_path(page),
                   "findings": [finding.to_dict() for finding in findings]}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(render_human(LintResult("repair_required" if findings else "clean", None, 1, 5, findings,
                                          {"REPAIR": len(findings)}, []), command="template"))
        return 1 if findings else 0
    parser = argparse.ArgumentParser(prog=f"wiki-lint {command}")
    if command == "task":
        parser.add_argument("bundle")
        parser.add_argument("paths", nargs="*")
    elif command == "file":
        parser.add_argument("path")
    elif command in {"corpus", "changed"}:
        parser.add_argument("paths", nargs="*")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--severity")
    args = parser.parse_args(argv[1:])
    try:
        severity = _severity(args.severity)
        if command == "task":
            result = engine.run(bundle=args.bundle, paths=_paths(args.paths, default=ROOT / "wiki"), severity_filter=severity)
        elif command == "file":
            result = engine.run(paths=[args.path], severity_filter=severity)
        elif command == "corpus":
            result = engine.run(bundle="corpus", paths=_paths(args.paths, default=ROOT / "wiki"), severity_filter=severity)
        else:
            changed = subprocess.run(["git", "diff", "--name-only", "HEAD"], cwd=ROOT, capture_output=True, text=True, check=False)
            files = [ROOT / line.strip() for line in changed.stdout.splitlines() if line.strip().endswith(".md")]
            result = engine.run(bundle="corpus", paths=files, severity_filter=severity)
    except (ValueError, KeyError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))
    else:
        print(render_human(result, command=command))
    return _exit_for(result)


def candidate_main(argv: list[str], registry) -> int:
    parser = argparse.ArgumentParser(prog="wiki-lint candidate")
    parser.add_argument("correction", nargs="+")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    correction = " ".join(args.correction).strip()
    query = correction.casefold()
    query_terms = {term for term in re.findall(r"[a-z0-9]+", query) if len(term) > 2}

    def score(rule) -> int:
        haystack = " ".join((rule.message, rule.title, *rule.tags)).casefold()
        return sum(term in haystack for term in query_terms)

    scored = [(score(rule), rule) for rule in registry.rules]
    matches = [rule for points, rule in scored if points == len(query_terms) and points]
    if not matches:
        matches = [rule for points, rule in scored if points >= 2]
    if matches:
        data = {"matches": [{"rule_id": rule.id, "title": rule.title, "message": rule.message} for rule in matches]}
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            for item in data["matches"]:
                print(f"{item['rule_id']}: {item['title']} — {item['message']}")
        return 0

    slug = re.sub(r"[^a-z0-9]+", "-", query).strip("-")[:48] or "candidate"
    candidate_dir = ROOT / "rules" / "candidates"
    candidate_dir.mkdir(parents=True, exist_ok=True)
    path = candidate_dir / f"{slug}.yml"
    if not path.exists():
        path.write_text(
            "id: CANDIDATE001\n"
            f"title: {json.dumps('Candidate: ' + correction)}\n"
            "category: retrieval\nscope: content\nseverity: WARN\n"
            "evaluator: human\nlifecycle: SHADOW\n"
            f"message: {json.dumps('DM correction: ' + correction)}\n"
            "repair: null\ntags: [candidate]\nconflicts: []\ndepends: []\n",
            encoding="utf-8",
        )
    data = {"candidate": str(path.relative_to(ROOT)), "lifecycle": "SHADOW", "promotion": "requires measured precision"}
    print(json.dumps(data, indent=2) if args.json else f"Created SHADOW candidate: {data['candidate']}")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--consolidate" in argv:
        values = [item for item in argv if item != "--consolidate"]
        return consolidate_main(values)
    first_positional = next((item for item in argv if not item.startswith("-")), None)
    return creative_main(argv) if first_positional in CREATIVE_COMMANDS else structural_main(argv)


if __name__ == "__main__":
    sys.exit(main())
