#!/usr/bin/env python3
"""Structural wiki lint plus the creative-lint rule engine.

Invocations without a creative subcommand delegate unchanged to
``tools/lint_wiki.py``. Creative commands are ``task``, ``file``, ``corpus``,
``changed``, ``rule``, and ``candidate``.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Any
ROOT = Path(__file__).resolve().parents[1]
LINT = ROOT / "tools" / "lint_wiki.py"
CREATIVE_COMMANDS = {"task", "file", "corpus", "changed", "rule", "candidate", "queue", "template"}
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))
from tools.wiki_ops.cli import resolve_vault


def run_lint(vault: Path, extra: list[str]) -> tuple[int, dict]:
    cmd = [sys.executable, str(LINT), "--json", str(vault), *extra]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr or f"lint_wiki.py exited {proc.returncode}\n")
        raise SystemExit(proc.returncode)
    if not proc.stdout.strip():
        raise SystemExit("lint_wiki.py produced no JSON")
    return proc.returncode, json.loads(proc.stdout)



def is_moc_page(relative: str) -> bool:
    name = Path(relative).name
    return name == "_index.md" or name.endswith("-index.md")

def _line_for_finding(vault: Path, item: dict[str, Any]) -> int:
    """Return an existing or best-effort 1-based source line for a finding."""
    existing = item.get("line")
    if isinstance(existing, int) and existing > 0:
        return existing
    location = item.get("location")
    if isinstance(location, dict):
        existing = location.get("line")
        if isinstance(existing, int) and existing > 0:
            return existing
    raw_path = item.get("file") or item.get("page") or item.get("path")
    if not raw_path:
        return 1
    path = Path(str(raw_path))
    candidates = [path] if path.is_absolute() else [vault / path, ROOT / path]
    source = next((candidate for candidate in candidates if candidate.is_file()), None)
    if source is None:
        return 1
    try:
        text = source.read_text(encoding="utf-8")
    except OSError:
        return 1
    needles: list[str] = []
    for key in ("text", "target", "token", "callout", "value"):
        value = item.get(key)
        if isinstance(value, str) and value:
            needles.append(value)
            if key == "target":
                needles.append(f"[[{value}]]")
    section = item.get("section")
    if isinstance(section, str) and section:
        needles.append(section)
    for needle in needles:
        offset = text.find(needle)
        if offset >= 0:
            return text.count("\n", 0, offset) + 1
    return 1


def _add_line_number(vault: Path, item: dict[str, Any]) -> dict[str, Any]:
    result = dict(item)
    result["line"] = _line_for_finding(vault, result)
    return result


def _iter_grouped_findings(rule: str, value: Any):
    if isinstance(value, list):
        for item in value:
            if isinstance(item, dict):
                yield rule, item
    elif isinstance(value, dict):
        for child_rule, child_value in value.items():
            yield from _iter_grouped_findings(f"{rule}.{child_rule}", child_value)


def structural_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, epilog="Front door: scripts/wiki lint owns lint usage; see wiki lint --help and wiki lint fix --help.")
    parser.add_argument("vault", nargs="?", default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--verbose", action="store_true", help="include clean checks and zero counts")
    parser.add_argument("--vault", dest="vault_override")
    parser.add_argument("--scope")
    parser.add_argument("--no-vale", dest="vale", action="store_false", default=True)
    parser.add_argument("--no-template", dest="template", action="store_false", default=True)
    parser.add_argument("--plan", action="store_true")
    parser.add_argument("--from", dest="findings_file")
    parser.add_argument("--hard", action="store_true", default=True)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--allow-relationship-type", action="append", default=[])
    args = parser.parse_args(argv)
    try:
        timing: dict[str, int] = {}
        vault = resolve_vault(args.vault_override or args.vault)
        from tools.wiki_ops.scope import parse_scope
        scope = parse_scope(args.scope)
        if scope:
            scope.resolve(vault)
        identities = []
        identity_stats = {"scanned": 0, "compared": 0, "index": {"hits": 0, "misses": 0}}
        started = time.monotonic()
        if scope:
            from tools.wiki_ops.identity import scan_identity_report
            identities, identity_stats = scan_identity_report(vault, scope=scope, persist=True)
        timing["tools/wiki_ops/identity.py"] = int((time.monotonic() - started) * 1000)
        ambiguous_identities = [item.to_dict() for item in identities if item.status == "ambiguous"]
        extra: list[str] = []
        if args.verbose:
            extra.append("--verbose")
        for value in args.allow_relationship_type:
            extra.extend(["--allow-relationship-type", value])
        if scope:
            extra.extend(["--scope", args.scope])
        source = json.loads(Path(args.findings_file).read_text(encoding="utf-8")) if args.findings_file else None
        started = time.monotonic()
        if source is None:
            code, report = run_lint(vault, extra)
        else:
            code, report = 0, source
        timing["tools/lint_wiki.py"] = int((time.monotonic() - started) * 1000)
        report["identity"] = {"status": "ambiguous" if ambiguous_identities else "resolved", "ambiguous": ambiguous_identities, "scanned": identity_stats["scanned"], "compared": identity_stats["compared"], "index": identity_stats["index"]}
        if ambiguous_identities:
            report["identity_ambiguous"] = True
        if args.template:
            started = time.monotonic()
            from tools.creative_lint.template_profile import template_conformance as profile_conformance
            from tools.wiki_ops.template_contracts import check_conformance, contract_for_type
            paths = scope.resolved_files if scope else [
                p.relative_to(vault).as_posix()
                for p in vault.rglob("*.md")
                if p.is_file() and not {"_archive", "_archives", "_raw", "_readouts", "_meta", "templates", ".obsidian"}.intersection(p.relative_to(vault).parts)
            ]
            template_findings = []
            for relative in paths:
                if is_moc_page(relative):
                    continue
                page = vault / relative
                try:
                    fields = __import__("tools.wiki_ops.mutations", fromlist=["frontmatter_fields"]).frontmatter_fields(page.read_text(encoding="utf-8"))
                    typ = (fields.get("type") or "").strip()
                    contract = contract_for_type(vault, typ) or contract_for_type(ROOT / "wiki", typ)
                    if contract:
                        template_findings.extend(check_conformance(relative, page.read_text(encoding="utf-8"), contract))
                    _, profile_findings = profile_conformance(page, root=ROOT)
                    for finding in profile_findings:
                        payload = finding.to_dict()
                        location = payload.get("location") or {}
                        template_findings.append({
                            "rule_id": payload["rule_id"],
                            "file": relative,
                            "line": location.get("line", 1),
                            "severity": payload["severity"],
                            "reason": payload["reason"],
                            "evidence": payload["evidence"],
                            "repair_class": payload.get("repair_class", "human_repair"),
                            "repair_target": payload.get("repair_target"),
                        })
                except (OSError, ValueError) as exc:
                    template_findings.append({"rule_id": "TMPL_error", "file": relative, "severity": "BLOCK", "reason": str(exc)})
            source_paths = [ROOT / "wiki" / "templates" / "faction.md", ROOT / ".agents" / "skills" / "faction-design" / "SKILL.md"]
            for source_path in source_paths:
                if source_path.is_file() and re.search(r"\bfaction\s+clock\b|\bagenda\s+clock\b", source_path.read_text(encoding="utf-8"), re.I):
                    template_findings.append({
                        "rule_id": "TMPL_deprecated_guidance",
                        "file": str(source_path.relative_to(ROOT)),
                        "severity": "BLOCK",
                        "repair_class": "human_repair",
                        "reason": "Deprecated faction-clock guidance remains in an authoritative source",
                    })
            if template_findings:
                report.setdefault("findings", {})["template_conformance"] = template_findings
                report.setdefault("counts", {})["template_conformance"] = len(template_findings)
                report["hard_fail"] = True
                report["status"] = "findings"
            timing["tools/wiki_ops/template_contracts.py"] = int((time.monotonic() - started) * 1000)
        if args.vale:
            from tools.creative_lint.bundles import BundleRegistry
            from tools.creative_lint.engine import LintEngine
            from tools.creative_lint.registry import Registry
            from tools.creative_lint.waivers import WaiverRegistry
            from tools.creative_lint import vale_adapter
            creative_paths = [vault / relative for relative in scope.resolved_files] if scope else [vault]
            started = time.monotonic()
            creative = LintEngine(
                Registry.load(ROOT / "rules" / "registry.yml"),
                BundleRegistry.load(ROOT / "rules" / "bundles.yml"),
                root=ROOT,
                vault=vault,
                waivers=WaiverRegistry.load(ROOT / "rules" / "waivers.json"),
            ).run(paths=creative_paths)
            timing["tools/creative_lint/engine.py"] = int((time.monotonic() - started) * 1000)
            timing.update(vale_adapter.TIMING)
            if creative.findings:
                findings = report.setdefault("findings", {})
                for finding in creative.findings:
                    payload = finding.to_dict()
                    rule_id = str(payload["rule_id"])
                    item = dict(payload)
                    location = item.pop("location", {})
                    item["file"] = location.get("file", "")
                    item["line"] = location.get("line", 1)
                    findings.setdefault(rule_id, []).append(item)
                    report.setdefault("counts", {})[rule_id] = len(findings[rule_id])
                report["hard_fail"] = True
                report["status"] = "findings"
        report["timing"] = timing
        if not args.verbose:
            counts = report.get("counts") or {}
            report["findings"] = {
                rule: items
                for rule, items in (report.get("findings") or {}).items()
                if counts.get(rule)
            }
            report["counts"] = {rule: value for rule, value in counts.items() if value}
            report["status"] = "findings" if report["counts"] else "clean"

        if args.plan:
            from tools.wiki_ops.repair_plans import build_plan
            report = build_plan(vault, report, scope=scope.to_dict() if scope else None)
        if scope:
            report["scope"] = scope.to_dict()
            report["files_checked"] = len(scope.resolved_files)
        for rule, items in (report.get("findings") or {}).items():
            if not isinstance(items, list):
                continue
            report["findings"][rule] = [
                _add_line_number(vault, item) if isinstance(item, dict) else item
                for item in items
            ]
        grouped: dict[str, list[dict[str, Any]]] = {}
        for rule, items in (report.get("findings") or {}).items():
            for grouped_rule, item in _iter_grouped_findings(rule, items):
                item = _add_line_number(vault, item)
                filename = str(item.get("file") or item.get("page") or "")
                if filename:
                    path = Path(filename)
                    if path.is_absolute():
                        try:
                            filename = path.resolve().relative_to(vault.resolve()).as_posix()
                        except ValueError:
                            filename = path.as_posix()
                    grouped.setdefault(filename, []).append({"rule": grouped_rule, **item})
        report["findings_by_file"] = {key: grouped[key] for key in sorted(grouped)}
        backlog = []
        for filename, items in grouped.items():
            path = vault / filename
            try:
                size = path.stat().st_size
            except OSError:
                size = 0
            backlog.append({"page": filename, "bytes": size, "findings": len(items)})
        backlog.sort(key=lambda item: (item["bytes"], item["page"]))
        report["backlog"] = backlog
        report["next_page"] = backlog[0]["page"] if backlog else None
        if args.json:
            print(json.dumps(report, sort_keys=True, separators=(",", ":")))
        else:
            print(json.dumps(report, indent=2, sort_keys=True))
        if ambiguous_identities:
            return 2
        if args.plan:
            return 2 if report.get("actions") else 0
        return 1 if any((report.get("counts") or {}).values()) or report.get("hard_fail") else 0
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2


def _paths(values: list[str], *, default: Path) -> list[Path]:
    return [Path(value) for value in values] if values else [default]


def _severity(value: str | None) -> set[str] | None:
    if not value:
        return None
    allowed = {"BLOCK", "REPAIR", "REVIEW", "WARN", "INFO"}
    result = {item.strip().upper() for item in value.split(",") if item.strip()}
    invalid = result - allowed
    if invalid:
        raise ValueError(f"unknown severity: {', '.join(sorted(invalid))}")
    return result


def _load_engine():
    from tools.creative_lint.bundles import BundleRegistry
    from tools.creative_lint.engine import LintEngine
    from tools.creative_lint.registry import Registry
    from tools.creative_lint.waivers import WaiverRegistry
    registry = Registry.load(ROOT / "rules" / "registry.yml")
    bundles = BundleRegistry.load(ROOT / "rules" / "bundles.yml")
    waivers = WaiverRegistry.load(ROOT / "rules" / "waivers.json")
    return LintEngine(registry, bundles, root=ROOT, vault=ROOT / "wiki", waivers=waivers), registry, bundles


def _exit_for(result) -> int:
    return {"repair_required": 1, "review_needed": 2, "clean": 0}[result.status]


def _snapshot(vault: Path, report: dict[str, Any]) -> str:
    digest = hashlib.sha256()
    digest.update(json.dumps(report, sort_keys=True, separators=(",", ":")).encode())
    if vault.is_dir():
        for path in sorted(vault.rglob("*.md")):
            if any(part in {".obsidian", "_archive", "_archives", "_raw", "_readouts", "_meta", "templates"} for part in path.relative_to(vault).parts):
                continue
            digest.update(path.relative_to(vault).as_posix().encode())
            digest.update(path.read_bytes())
    return "sha256:" + digest.hexdigest()


def consolidate_main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="wiki-lint --consolidate")
    parser.add_argument("vault", nargs="?", default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--approve", action="store_true")
    args = parser.parse_args(argv)
    try:
        vault = resolve_vault(args.vault)
    except ValueError as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2
    try:
        _, report = run_lint(vault, ["--hard-only"])
    except (SystemExit, json.JSONDecodeError) as exc:
        print(f"wiki-lint: unable to build consolidation plan: {exc}", file=sys.stderr)
        return 2
    # Structural findings do not contain enough information to safely invent
    # canon or judgment repairs. The initial safe plan is therefore empty;
    # future deterministic repair kinds may be added without changing schema.
    plan = {
        "vault": str(vault),
        "snapshot": _snapshot(vault, report),
        "actions": [],
        "requires_approval": True,
        "approved": bool(args.approve),
    }
    result = {"status": "applied" if args.approve else "dry_run", "plan": plan}
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(f"wiki-lint --consolidate: {result['status']} ({len(plan['actions'])} safe actions)")
    return 0


def creative_main(argv: list[str]) -> int:
    from tools.creative_lint.cli_output import render_human, render_queue
    from tools.creative_lint.template_profile import template_conformance
    from tools.creative_lint.engine import LintResult
    command = argv[0] if argv else ""
    try:
        engine, registry, bundles = _load_engine()
    except (OSError, ValueError, KeyError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2
    if command == "rule":
        parser = argparse.ArgumentParser(prog="wiki-lint rule")
        parser.add_argument("rule_id")
        args = parser.parse_args(argv[1:])
        try:
            rule = registry.get(args.rule_id)
        except KeyError:
            print(f"Unknown rule ID: {args.rule_id}", file=sys.stderr)
            return 2
        print(f"{rule.id}: {rule.title}")
        print(f"Category:  {rule.category}")
        print(f"Severity:  {rule.severity}")
        print(f"Evaluator: {rule.evaluator}")
        print(f"Lifecycle: {rule.lifecycle}")
        print(f"Scope:     {rule.scope}")
        print(f"Message:   {rule.message}")
        print(f"Repair:    {rule.repair or 'none'}")
        print(f"Tags:      {', '.join(rule.tags) or 'none'}")
        memberships = []
        for name in bundles.available():
            bundle = bundles.get(name)
            for gate in ("block", "review", "diagnostics"):
                if rule.category in (getattr(bundle, gate) or []):
                    memberships.append(f"{name} ({gate})")
        print(f"Bundles:   {', '.join(memberships) or 'none'}")
        return 0
    if command == "candidate":
        return candidate_main(argv[1:], registry)
    if command == "queue":
        parser = argparse.ArgumentParser(prog="wiki-lint queue")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        try:
            data = engine.dirty_queue()
        except (ValueError, KeyError) as exc:
            print(f"wiki-lint: {exc}", file=sys.stderr)
            return 2
        print(json.dumps(data, indent=2, sort_keys=True) if args.json else render_queue(data))
        return 0
    if command == "template":
        parser = argparse.ArgumentParser(prog="wiki-lint template")
        parser.add_argument("path")
        parser.add_argument("--json", action="store_true")
        args = parser.parse_args(argv[1:])
        page = Path(args.path)
        if not page.is_absolute():
            page = (ROOT / page).resolve()
        if not page.is_file():
            print(f"wiki-lint: page not found: {page}", file=sys.stderr)
            return 2
        try:
            selected, findings = template_conformance(page, root=ROOT)
        except (OSError, ValueError) as exc:
            print(f"wiki-lint: {exc}", file=sys.stderr)
            return 2
        if selected is None:
            print(f"wiki-lint: no template resolved for {page}", file=sys.stderr)
            return 2
        def display_path(path: Path) -> str:
            try:
                return str(path.relative_to(ROOT))
            except ValueError:
                return str(path)
        payload = {"template": display_path(selected), "page": display_path(page),
                   "findings": [finding.to_dict() for finding in findings]}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print(render_human(LintResult("repair_required" if findings else "clean", None, 1, 5, findings,
                                          {"REPAIR": len(findings)}, []), command="template"))
        return 1 if findings else 0
    parser = argparse.ArgumentParser(prog=f"wiki-lint {command}")
    if command == "task":
        parser.add_argument("bundle")
        parser.add_argument("paths", nargs="*")
    elif command == "file":
        parser.add_argument("path")
    elif command in {"corpus", "changed"}:
        parser.add_argument("paths", nargs="*")
    parser.add_argument("--state-file")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--severity")
    args = parser.parse_args(argv[1:])
    state = json.loads(Path(args.state_file).read_text(encoding="utf-8")) if args.state_file else None
    try:
        severity = _severity(args.severity)
        if command == "task":
            result = engine.run(bundle=args.bundle, paths=_paths(args.paths, default=ROOT / "wiki"), severity_filter=severity, state=state)
        elif command == "file":
            result = engine.run(paths=[args.path], severity_filter=severity, state=state)
        elif command == "corpus":
            result = engine.run(bundle="corpus", paths=_paths(args.paths, default=ROOT / "wiki"), severity_filter=severity, state=state)
        else:
            changed = subprocess.run(["git", "diff", "--name-only", "HEAD"], cwd=ROOT, capture_output=True, text=True, check=False)
            files = [ROOT / line.strip() for line in changed.stdout.splitlines() if line.strip().endswith(".md")]
            result = engine.run(bundle="corpus", paths=files, severity_filter=severity, state=state)
    except (ValueError, KeyError) as exc:
        print(f"wiki-lint: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(result.to_dict(), indent=2, sort_keys=True))
    else:
        print(render_human(result, command=command))
    return _exit_for(result)


def candidate_main(argv: list[str], registry) -> int:
    parser = argparse.ArgumentParser(prog="wiki-lint candidate")
    parser.add_argument("correction", nargs="+")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    correction = " ".join(args.correction).strip()
    query = correction.casefold()
    query_terms = {term for term in re.findall(r"[a-z0-9]+", query) if len(term) > 2}

    def score(rule) -> int:
        haystack = " ".join((rule.message, rule.title, *rule.tags)).casefold()
        return sum(term in haystack for term in query_terms)

    scored = [(score(rule), rule) for rule in registry.rules]
    matches = [rule for points, rule in scored if points == len(query_terms) and points]
    if not matches:
        matches = [rule for points, rule in scored if points >= 2]
    if matches:
        data = {"matches": [{"rule_id": rule.id, "title": rule.title, "message": rule.message} for rule in matches]}
        if args.json:
            print(json.dumps(data, indent=2))
        else:
            for item in data["matches"]:
                print(f"{item['rule_id']}: {item['title']} — {item['message']}")
        return 0

    slug = re.sub(r"[^a-z0-9]+", "-", query).strip("-")[:48] or "candidate"
    candidate_dir = ROOT / "rules" / "candidates"
    candidate_dir.mkdir(parents=True, exist_ok=True)
    path = candidate_dir / f"{slug}.yml"
    if not path.exists():
        path.write_text(
            "id: CANDIDATE001\n"
            f"title: {json.dumps('Candidate: ' + correction)}\n"
            "category: retrieval\nscope: content\nseverity: WARN\n"
            "evaluator: human\nlifecycle: SHADOW\n"
            f"message: {json.dumps('DM correction: ' + correction)}\n"
            "repair: null\ntags: [candidate]\nconflicts: []\ndepends: []\n",
            encoding="utf-8",
        )
    data = {"candidate": str(path.relative_to(ROOT)), "lifecycle": "SHADOW", "promotion": "requires measured precision"}
    print(json.dumps(data, indent=2) if args.json else f"Created SHADOW candidate: {data['candidate']}")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if "--consolidate" in argv:
        values = [item for item in argv if item != "--consolidate"]
        return consolidate_main(values)
    first_positional = next((item for item in argv if not item.startswith("-")), None)
    return creative_main(argv) if first_positional in CREATIVE_COMMANDS else structural_main(argv)


if __name__ == "__main__":
    sys.exit(main())
