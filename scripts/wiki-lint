#!/usr/bin/env python3
"""Schedulable wiki health lint. Wraps tools/lint_wiki.py. Adds no checks.

Default (--hard): fail only on broken_links and missing_frontmatter.
--all: fail on any finding (same as tools/lint_wiki.py).

Usage (repo root):
  ./scripts/wiki-lint
  ./scripts/wiki-lint --json
  ./scripts/wiki-lint --all
  ./scripts/wiki-lint --hard wiki
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LINT = ROOT / "tools" / "lint_wiki.py"
HARD = ("broken_links", "missing_frontmatter")


def run_lint(vault: Path, extra: list[str]) -> dict:
    cmd = [sys.executable, str(LINT), "--json", str(vault), *extra]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode not in (0, 1):
        sys.stderr.write(proc.stderr or f"lint_wiki.py exited {proc.returncode}\n")
        raise SystemExit(proc.returncode)
    if not proc.stdout.strip():
        raise SystemExit("lint_wiki.py produced no JSON")
    return json.loads(proc.stdout)


def hard_fail(counts: dict) -> bool:
    return any(int(counts.get(key, 0) or 0) > 0 for key in HARD)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("vault", nargs="?", default="wiki")
    parser.add_argument("--json", action="store_true")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--hard", action="store_true", default=True, help="fail on HARD findings only (default)")
    mode.add_argument("--all", action="store_true", help="fail on any finding")
    parser.add_argument("--allow-lifecycle", action="append", default=[])
    parser.add_argument("--allow-relationship-type", action="append", default=[])
    args = parser.parse_args(argv)

    extra: list[str] = []
    for value in args.allow_lifecycle:
        extra.extend(["--allow-lifecycle", value])
    for value in args.allow_relationship_type:
        extra.extend(["--allow-relationship-type", value])

    vault = Path(args.vault)
    if not vault.is_absolute():
        vault = (Path.cwd() / vault).resolve()
    report = run_lint(vault, extra)
    counts = report.get("counts", {})
    report["hard"] = list(HARD)
    report["hard_fail"] = hard_fail(counts)
    fail = any(counts.values()) if args.all else report["hard_fail"]

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        pages = report.get("scope", {}).get("pages", "?")
        print(f"wiki-lint: {pages} pages, hard_fail={str(fail).lower()}")
        print(
            "hard: "
            + ", ".join(f"{key}={counts.get(key, 0)}" for key in HARD)
        )
        soft = [f"{k}={v}" for k, v in sorted(counts.items()) if k not in HARD and v]
        if soft:
            print("soft: " + ", ".join(soft))
    return 1 if fail else 0


if __name__ == "__main__":
    sys.exit(main())
