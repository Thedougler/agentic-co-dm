#!/usr/bin/env python3
"""Agent-shaped structural lint, retrieval, and health CLI."""
from __future__ import annotations

import argparse
import contextlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
_VENV_PY = ROOT / ".venv" / "bin" / "python"
if _VENV_PY.is_file() and Path(sys.executable).resolve() != _VENV_PY.resolve():
    os.execv(str(_VENV_PY), [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tools.wiki_ops.cli import configured_vault, emit_json, resolve_vault
from tools.wiki_ops.health import build_context_load, build_core_files, build_focus, build_health_snapshot, build_trends
from tools.wiki_ops.lint_cache import digest_rules, load_cache, lookup_entry, save_cache, update_entry
from tools.wiki_ops.pretty import render_health, render_lint, render_query, render_usage_error
from tools.wiki_ops.timing import ProgressHeartbeat, append_command_record, elapsed_ms, now_ms, timing_payload
from tools.wiki_ops.repair_plans import apply_safe_fix_plan, build_safe_fix_plan
from tools.wiki_ops.worklist import DEFAULT_HARD_KEYS, build_worklist

SKIP_DIRS = frozenset({".obsidian", "_archive", "_archives", "_raw", "_readouts", "_meta", "templates", "attachments"})


def _trace_path() -> Path | None:
    raw = os.environ.get("WIKI_EFFICIENCY_TRACE")
    return Path(raw) if raw else None


def _tracker_root() -> Path:
    raw = os.environ.get("WIKI_TRACKER_ROOT")
    return Path(raw) if raw else ROOT


def _machine_error(message: str, *, pretty: bool = False) -> int:
    if pretty:
        print(render_usage_error(message), file=sys.stderr)
    else:
        emit_json({"error": message, "status": "error"})
    return 2


def _live_files(vault: Path) -> list[Path]:
    return sorted(
        path for path in vault.rglob("*.md")
        if path.is_file() and not SKIP_DIRS.intersection(path.relative_to(vault).parts)
    )


def _resolve_paths(vault: Path, values: list[str]) -> list[str]:
    if not values:
        return [path.relative_to(vault).as_posix() for path in _live_files(vault)]
    ordered: list[str] = []
    seen: set[str] = set()
    root = vault.resolve()
    for raw in values:
        candidate_input = Path(raw)
        if candidate_input.is_absolute():
            raise ValueError(f"path must be vault-relative: {raw!r}")
        candidate = (root / candidate_input).resolve()
        try:
            candidate.relative_to(root)
        except ValueError as exc:
            raise ValueError(f"path escapes vault: {raw!r}") from exc
        if not candidate.exists():
            raise ValueError(f"path not found in vault: {raw!r}")
        if SKIP_DIRS.intersection(candidate.relative_to(root).parts):
            raise ValueError(f"path is in a skipped directory: {raw!r}")
        if candidate.is_file():
            if candidate.suffix.casefold() != ".md":
                raise ValueError(f"path must be a Markdown file: {raw!r}")
            relative = candidate.relative_to(root).as_posix()
            if relative not in seen:
                seen.add(relative)
                ordered.append(relative)
        elif candidate.is_dir():
            for path in sorted(
                child for child in candidate.rglob("*.md")
                if child.is_file() and not SKIP_DIRS.intersection(child.relative_to(root).parts)
            ):
                relative = path.relative_to(root).as_posix()
                if relative not in seen:
                    seen.add(relative)
                    ordered.append(relative)
        else:
            raise ValueError(f"path is not a file or directory: {raw!r}")
    return ordered


def _finding(rule: str, item: Any, vault: Path) -> dict[str, Any] | None:
    if not isinstance(item, dict):
        return None
    location = item.get("location") if isinstance(item.get("location"), dict) else {}
    raw_file = item.get("file") or item.get("page") or item.get("path") or location.get("file")
    if not raw_file:
        return None
    path = Path(str(raw_file))
    if path.is_absolute():
        try:
            raw_file = path.resolve().relative_to(vault.resolve()).as_posix()
        except ValueError:
            raw_file = path.as_posix()
    else:
        raw_file = path.as_posix()
    try:
        line = max(1, int(item.get("line") or location.get("line") or 1))
    except (TypeError, ValueError):
        line = 1
    result = {
        "rule": str(rule),
        "file": raw_file,
        "line": line,
        "severity": str(item.get("severity") or item.get("level") or "WARN"),
        "message": str(item.get("message") or item.get("reason") or item.get("text") or ""),
    }
    for key in ("evidence", "action", "owner", "code", "source", "repair_class", "repair_action", "repair_target", "target", "reason"):
        value = item.get(key)
        if value not in (None, ""):
            result[key] = value
    return result


def _flatten(report: dict[str, Any], vault: Path) -> list[dict[str, Any]]:
    flattened: list[dict[str, Any]] = []
    findings = report.get("findings") or {}
    if isinstance(findings, dict):
        for rule, items in findings.items():
            if isinstance(items, dict):
                items = [items]
            if isinstance(items, list):
                for item in items:
                    normalized = _finding(str(rule), item, vault)
                    if normalized:
                        flattened.append(normalized)
    elif isinstance(findings, list):
        for item in findings:
            if isinstance(item, dict):
                normalized = _finding(str(item.get("rule") or item.get("rule_id") or "unknown"), item, vault)
                if normalized:
                    flattened.append(normalized)
    flattened.sort(key=lambda item: (item["file"], item["line"], item["rule"], item["message"]))
    return flattened


def _run_structural(vault: Path, relative: list[str]) -> dict[str, Any]:
    command = [
        sys.executable,
        str(ROOT / "scripts/wiki-lint"),
        "--json",
        str(vault),
        "--scope",
        "files:" + ",".join(relative),
    ]
    proc = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    if proc.returncode not in (0, 1, 2):
        raise RuntimeError(proc.stderr.strip() or f"lint checker exited {proc.returncode}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        detail = proc.stderr.strip() or f"lint checker exited {proc.returncode}"
        raise RuntimeError(f"{detail}: {exc}") from exc


def _group_findings(findings: list[dict[str, Any]]) -> dict[str, list[dict[str, Any]]]:
    grouped: dict[str, list[dict[str, Any]]] = {}
    for finding in findings:
        grouped.setdefault(str(finding.get("rule") or "unknown"), []).append(finding)
    return grouped


def _cached_findings(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, dict):
        return [
            item
            for records in value.values()
            if isinstance(records, list)
            for item in records
            if isinstance(item, dict)
        ]
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]
    return []


def _config_digest(_vault: Path, _args: argparse.Namespace) -> str:
    return digest_rules(
        ROOT,
        extra={"lint_output": "all", "vale": True, "template": True},
    )


def _ledger() -> dict[str, Any]:
    rows = _run_json(
        [sys.executable, str(ROOT / "scripts/error-ledger.py"), "--root", str(_tracker_root()), "--format", "json", "error", "list"],
        _tracker_root() if _tracker_root().exists() else ROOT,
    )
    open_rows = [
        row for row in rows
        if isinstance(row, dict) and str(row.get("status", "")).casefold() == "open"
    ] if isinstance(rows, list) else []
    return {
        "open": len(open_rows),
        "ids": [str(row.get("id")) for row in open_rows if row.get("id")],
    }



def _progress(task: str, **fields: Any) -> None:
    bits = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"wiki {task}: {bits}", file=sys.stderr, flush=True)


def _tune(kind: str, ranked: list[tuple[str, int]]) -> None:
    if not ranked:
        return
    script, elapsed = ranked[0]
    nxt_script, nxt = ranked[1] if len(ranked) > 1 else ("", 0)
    if elapsed < 500:
        return
    if nxt and elapsed < int(1.4 * nxt) and (elapsed - nxt) < 400:
        return
    follow = f", next {nxt_script} {nxt}ms" if nxt_script else ""
    print(
        f"wiki {kind}: tune {script} — {elapsed}ms{follow}. Fix that checker this sitting.",
        file=sys.stderr,
        flush=True,
    )


def _timed(task: str, fn, times: list[tuple[str, int]] | None = None):
    start = now_ms()
    value = fn()
    elapsed = elapsed_ms(start)
    _progress(task, ms=elapsed)
    if times is not None:
        times.append((task, elapsed))
    return value



def _compute_lint(
    args: argparse.Namespace,
    vault: Path,
    resolved_paths: list[str] | None = None,
) -> tuple[dict[str, Any], int]:
    paths = (
        list(resolved_paths)
        if resolved_paths is not None
        else _resolve_paths(vault, args.paths)
    )
    paths = [relative for relative in paths if (vault / relative).is_file()]
    digest = _config_digest(vault, args)
    cache = load_cache(vault)
    findings: list[dict[str, Any]] = []
    hard_keys: set[str] = set()
    hits = misses = vale_skipped = 0
    pending: list[str] = []
    identity: dict[str, Any] | None = None
    for relative in paths:
        cached = lookup_entry(cache, vault, relative, digest)
        if cached is not None:
            findings.extend(_cached_findings(cached.get("results")))
            hits += 1
            vale_skipped += 1
        else:
            pending.append(relative)

    total = len(paths)
    if pending:
        _progress("lint", done=f"{hits}/{total}", hits=hits, pending=len(pending))
        started = now_ms()
        report = _run_structural(vault, pending)
        elapsed = elapsed_ms(started)
        current_findings = _flatten(report, vault)
        if isinstance(report.get("identity"), dict):
            identity = report["identity"]
        grouped: dict[str, list[dict[str, Any]]] = {relative: [] for relative in pending}
        for item in current_findings:
            if item["file"] in grouped:
                grouped[item["file"]].append(item)
        hard_keys.update(str(key) for key in ((report.get("schema") or {}).get("hard") or []))
        for relative in pending:
            current = grouped[relative]
            findings.extend(current)
            update_entry(cache, vault, relative, digest, {"file": relative}, _group_findings(current))
            misses += 1
        save_cache(vault, cache)
        _progress("lint", done=f"{hits + misses}/{total}", hits=hits, misses=misses, n=len(pending), ms=elapsed)
        timing = report.get("timing") if isinstance(report.get("timing"), dict) else {}
        ranked = sorted(
            ((script, int(elapsed_ms)) for script, elapsed_ms in timing.items() if isinstance(elapsed_ms, (int, float))),
            key=lambda item: item[1],
            reverse=True,
        )
        for script, script_ms in ranked:
            _progress("lint", script=script, ms=script_ms, n=len(pending))
        _tune("lint", ranked)
    else:
        save_cache(vault, cache)

    hard_rule_set = hard_keys or set(DEFAULT_HARD_KEYS)
    page_bytes = {relative: (vault / relative).stat().st_size for relative in paths if (vault / relative).is_file()}
    result = build_worklist(
        findings,
        files_checked=len(paths),
        scope={"paths": list(args.paths)},
        cache={"hits": hits, "misses": misses, "vale_skipped": vale_skipped},
        hard_keys=hard_rule_set,
        full=bool(getattr(args, "full", True)),
        vault=vault,
        page_bytes=page_bytes,
        file_order=paths,
    )
    # Identity runs only for cache misses; a fully cached lint scans nothing.
    result["identity"] = identity if identity is not None else {
        "status": "skipped", "ambiguous": [], "scanned": 0, "compared": 0, "index": {"hits": 0, "misses": 0},
    }
    ledger = _ledger()
    result["ledger"] = ledger
    # Lint scope describes checker output; operational ledger state is reported
    # separately and belongs in holistic health status.
    code = 1 if bool(result.get("counts")) else 0
    return result, code



def _finish(
    command: str,
    start: float,
    code: int,
    result: dict[str, Any],
    *,
    pretty: bool,
    renderer,
    cache: dict[str, Any] | None = None,
    extra_record: dict[str, Any] | None = None,
) -> int:
    duration = max(0, elapsed_ms(start))
    if result.get("status") != "error":
        result["timing"] = timing_payload(command, duration, cache)
    append_command_record(command, duration, code, cache, trace_path=_trace_path(), extra=extra_record)
    if pretty:
        print(renderer(result))
    else:
        emit_json(result)
    return code


def _lint(args: argparse.Namespace, vault: Path, start: float) -> int:
    result, code = _compute_lint(args, vault)
    return _finish("lint", start, code, result, pretty=args.pretty, renderer=render_lint, cache=result.get("cache"))

def _flatten_result_findings(result: dict[str, Any]) -> list[dict[str, Any]]:
    findings: list[dict[str, Any]] = []
    for group in result.get("files", ()) if isinstance(result.get("files"), list) else ():
        if not isinstance(group, dict):
            continue
        for finding in group.get("findings", ()) if isinstance(group.get("findings"), list) else ():
            if isinstance(finding, dict):
                findings.append(finding)
    return findings

def _finding_identity(finding: dict[str, Any]) -> str:
    """Build a stable same-scope identity for progress comparison."""
    evidence = finding.get("evidence") or finding.get("target") or finding.get("message") or ""
    return "|".join(
        str(finding.get(key) or "")
        for key in ("rule", "file", "line")
    ) + f"|{evidence}"


def _finding_identities(result: dict[str, Any]) -> set[str]:
    return {
        _finding_identity(item)
        for item in _flatten_result_findings(result)
    }


def _next_identity(result: dict[str, Any]) -> tuple[Any, ...]:
    next_item = result.get("next")
    if not isinstance(next_item, dict):
        return ()
    return (
        next_item.get("path"),
        next_item.get("findings"),
        next_item.get("bytes"),
    )


def _lint_fix(args: argparse.Namespace, vault: Path, start: float) -> int:
    resolved_paths = _resolve_paths(vault, args.paths)
    pre_args = argparse.Namespace(**vars(args))
    pre_args.full = True
    pre_result, pre_code = _compute_lint(pre_args, vault, resolved_paths)
    if pre_code == 2:
        return _finish(
            "lint fix",
            start,
            2,
            {"status": "error", "error": "lint preflight failed"},
            pretty=args.pretty,
            renderer=render_lint,
        )
    operations, skipped = build_safe_fix_plan(
        vault,
        _flatten_result_findings(pre_result),
        scope={"paths": resolved_paths},
    )
    applied, failed = apply_safe_fix_plan(vault, operations)
    skipped.extend(failed)
    post_args = argparse.Namespace(**vars(args))
    post_args.full = bool(args.full)
    post_result, post_code = _compute_lint(post_args, vault, resolved_paths)
    changed_files = sorted({path for item in applied for path in item.get("changed_files", [])})
    before_ids = _finding_identities(pre_result)
    after_ids = _finding_identities(post_result)
    next_changed = _next_identity(pre_result) != _next_identity(post_result)
    progress = {
        "before_total": max(0, int(pre_result.get("finding_total", len(before_ids)))),
        "after_total": max(0, int(post_result.get("finding_total", len(after_ids)))),
        "resolved": sorted(before_ids - after_ids),
        "changed_files": changed_files,
        "next_changed": next_changed,
        "state_changed": bool(
            before_ids != after_ids
            or changed_files
            or next_changed
        ),
    }
    result = {
        "status": post_result.get("status", "clean"),
        "scope": {"paths": list(args.paths)},
        "applied": applied,
        "skipped": skipped,
        "remaining": post_result,
        "full": bool(args.full),
        "changed_files": changed_files,
        "progress": progress,
        "cache": post_result.get("cache", {}),
    }
    return _finish(
        "lint fix",
        start,
        post_code,
        result,
        pretty=args.pretty,
        renderer=render_lint,
        cache=result["cache"],
    )


def _query(args: argparse.Namespace, start: float) -> int:
    environment = os.environ.copy()
    environment.pop("CI", None)
    command = ["qmd", "query", args.phrase, "-c", args.collection, "-n", str(args.count), "--format", "json"]
    proc = subprocess.run(command, cwd=ROOT, env=environment, capture_output=True, text=True)
    if proc.returncode:
        code = _machine_error(proc.stderr.strip() or "qmd query failed", pretty=args.pretty)
        append_command_record("query", max(0, elapsed_ms(start)), code, trace_path=_trace_path())
        return code
    try:
        raw = json.loads(proc.stdout or "[]")
    except json.JSONDecodeError as exc:
        code = _machine_error(f"qmd returned invalid JSON: {exc}", pretty=args.pretty)
        append_command_record("query", max(0, elapsed_ms(start)), code, trace_path=_trace_path())
        return code
    rows = raw.get("results", raw.get("hits", raw)) if isinstance(raw, dict) else raw
    hits = []
    for item in rows if isinstance(rows, list) else []:
        if not isinstance(item, dict):
            continue
        path = str(item.get("path") or item.get("filepath") or item.get("file") or item.get("url") or "")
        if path.startswith("qmd://"):
            path = path.split("qmd://", 1)[1]
        hits.append({
            "title": str(item.get("title") or Path(path).stem),
            "path": path,
            "id": str(item.get("id") or item.get("docid") or item.get("source") or ""),
        })

    result = {"status": "ok", "collection": args.collection, "hits": hits[: args.count]}
    _progress("query", hits=len(result["hits"]), ms=elapsed_ms(start))
    return _finish("query", start, 0, result, pretty=args.pretty, renderer=render_query)

def _delegate_bulk(command: str, values: list[str], vault: Path) -> int:
    backend_command = "transact" if command == "repair" else "mutate"
    forwarded = list(values)
    if "--vault" not in forwarded:
        forwarded.extend(["--vault", str(vault)])
    if "--json" not in forwarded:
        forwarded.append("--json")
    proc = subprocess.run(
        [sys.executable, str(ROOT / "scripts/wiki-bulk-ops"), backend_command, *forwarded],
        cwd=ROOT,
        capture_output=False,
        text=True,
    )
    return proc.returncode


def _run_json(command: list[str], cwd: Path) -> Any:
    proc = subprocess.run(command, cwd=cwd, capture_output=True, text=True)
    try:
        return json.loads(proc.stdout or "null")
    except json.JSONDecodeError:
        return None


def _load_jsonl(path: Path) -> list[dict[str, Any]]:
    if not path.is_file():
        return []
    rows: list[dict[str, Any]] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    for line in lines:
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            rows.append(value)
    return rows


def _load_maintenance_module():
    import importlib.machinery
    import importlib.util

    path = str(ROOT / "scripts/wiki-maintain")
    loader = importlib.machinery.SourceFileLoader("wiki_maintain", path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("unable to load Layer A maintenance module")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _tokens(vault: Path, paths: list[str], args: argparse.Namespace) -> int | None:
    command = [sys.executable, str(ROOT / "scripts/token-count.py")]
    if not args.paths:
        command.extend(["--sum", str(vault)])
    else:
        command.extend(str(vault / relative) if not Path(relative).is_absolute() else relative for relative in args.paths)
    payload = _run_json(command, ROOT)
    if not isinstance(payload, dict):
        return None
    if payload.get("total_tokens") is not None:
        try:
            return int(payload["total_tokens"])
        except (TypeError, ValueError):
            return None
    files = payload.get("files")
    if isinstance(files, list):
        return sum(int(item.get("tokens") or 0) for item in files if isinstance(item, dict))
    return None


def _health(args: argparse.Namespace, vault: Path, start: float) -> int:
    lint_args = argparse.Namespace(paths=args.paths, full=False)
    times: list[tuple[str, int]] = []
    lint, lint_code = _timed("health.lint", lambda: _compute_lint(lint_args, vault), times)
    paths = _resolve_paths(vault, args.paths)
    pages = [vault / relative for relative in paths]
    bytes_total = sum(path.stat().st_size for path in pages if path.is_file())
    maintenance = _timed("scripts/wiki-maintain", _load_maintenance_module, times)
    a2 = _timed("scripts/wiki-maintain:context-waste", lambda: maintenance.step_context_waste(str(vault), ROOT), times)
    a5 = _timed("scripts/wiki-maintain:raw-empty", lambda: maintenance.step_raw_empty(str(vault), ROOT), times)
    a6 = _timed("scripts/wiki-maintain:remorph", lambda: maintenance.step_a6_dry_run_plans(str(vault), ROOT), times)
    policy = _timed("scripts/wiki-maintain:policy", lambda: maintenance.step_policy_conflicts(ROOT), times)
    tracker = _tracker_root()
    sittings = _timed(
        "scripts/error-ledger.py:sitting",
        lambda: _run_json(
            [sys.executable, str(ROOT / "scripts/error-ledger.py"), "--root", str(tracker), "--format", "json", "sitting", "list"],
            tracker if tracker.exists() else ROOT,
        ),
        times,
    )
    errors = _timed(
        "scripts/error-ledger.py:error",
        lambda: _run_json(
            [sys.executable, str(ROOT / "scripts/error-ledger.py"), "--root", str(tracker), "--format", "json", "error", "list"],
            tracker if tracker.exists() else ROOT,
        ),
        times,
    )
    traces = _load_jsonl(_trace_path() or (ROOT / ".local/efficiency/traces.jsonl"))
    trends = build_trends(sittings if sittings is not None else [], errors if errors is not None else [], traces)
    focus = build_focus(lint, remorph=a6, open_errors=errors, cap=5)
    tokens = _timed("scripts/token-count.py", lambda: _tokens(vault, paths, args), times)

    context = _timed(
        "health.context",
        lambda: build_context_load(root=ROOT, vault=vault, traces=traces),
        times,
    )
    core = _timed("health.core", lambda: build_core_files(vault), times)
    if isinstance(context, dict):
        context["act"] = list(context.get("act") or []) + list(core.get("act") or [])
    open_ledger = any(
        isinstance(row, dict) and str(row.get("status", "")).casefold() == "open"
        for row in (errors or [])
    )
    _tune(
        "health",
        sorted(((name, ms) for name, ms in times if name != "health.lint"), key=lambda item: item[1], reverse=True),
    )
    dirty = lint.get("status") == "findings" or bool(core.get("issues")) or open_ledger
    result = build_health_snapshot(
        status="findings" if dirty else "clean",
        pages=len(pages),
        bytes=bytes_total,
        tokens=tokens,
        lint=lint,
        waste=a2.get("metric") if isinstance(a2, dict) else a2,
        staging=a5.get("metric") if isinstance(a5, dict) else a5,
        remorph=a6.get("metric") if isinstance(a6, dict) else a6,
        policy={
            "ok": bool(policy.get("ok", True)) if isinstance(policy, dict) else True,
            "conflict_count": len((policy or {}).get("conflicts") or []) if isinstance(policy, dict) else 0,
        },
        trends=trends,
        focus=focus,
        context=context,
    )
    cache = result.get("lint", {}).get("cache") if isinstance(result.get("lint"), dict) else lint.get("cache")
    first_turn = (context or {}).get("first_turn") if isinstance(context, dict) else {}
    extra = {"first_turn_tokens": int((first_turn or {}).get("total_tokens") or 0)}
    return _finish(
        "health",
        start,
        1 if lint_code or dirty else 0,
        result,
        pretty=args.pretty,
        renderer=render_health,
        cache=cache,
        extra_record=extra,
    )



def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="wiki")
    commands = root.add_subparsers(dest="command", required=True)
    lint = commands.add_parser("lint")
    lint.add_argument("paths", nargs="*")
    lint.add_argument("--full", action="store_true", default=True, help="compatibility no-op; lint is always full")
    lint.add_argument("--pretty", action="store_true")
    lint.add_argument("--json", action="store_true")
    query = commands.add_parser("query")
    query.add_argument("phrase")
    query.add_argument("--collection", default="wiki")
    query.add_argument("-n", "--count", type=int, default=10)
    query.add_argument("--pretty", action="store_true")
    query.add_argument("--json", action="store_true")
    mutate = commands.add_parser("mutate", help="apply a typed semantic mutation")
    mutate.add_argument("values", nargs=argparse.REMAINDER)
    repair = commands.add_parser("repair", help="apply an approved typed repair plan")
    repair.add_argument("values", nargs=argparse.REMAINDER)
    health = commands.add_parser("health")
    health.add_argument("paths", nargs="*")
    health.add_argument("--pretty", action="store_true")
    health.add_argument("--json", action="store_true")
    return root


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    lint_fix = args.command == "lint" and bool(args.paths and args.paths[0] == "fix")
    if lint_fix:
        args.paths = args.paths[1:]
    start = now_ms()
    heartbeat_command = "lint fix" if lint_fix else args.command
    heartbeat = ProgressHeartbeat(heartbeat_command) if args.command in {"lint", "health"} else contextlib.nullcontext()
    with heartbeat:
        try:
            if args.command == "query":
                return _query(args, start)
            vault = resolve_vault(configured_vault())
            if args.command in {"mutate", "repair"}:
                return _delegate_bulk(args.command, args.values, vault)
            if args.command == "lint":
                return _lint_fix(args, vault, start) if lint_fix else _lint(args, vault, start)
            return _health(args, vault, start)
        except (OSError, ValueError, RuntimeError) as exc:
            code = _machine_error(str(exc), pretty=getattr(args, "pretty", False))
            command = "lint fix" if lint_fix else getattr(args, "command", "lint")
            append_command_record(command, max(0, elapsed_ms(start)), code, trace_path=_trace_path())
            return code


if __name__ == "__main__":
    raise SystemExit(main())
