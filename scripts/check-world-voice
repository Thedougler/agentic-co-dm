#!/usr/bin/env python3
"""World-voice search for wiki pages (docs/agents/table-ready.md § Fill the silence).

Prints each body line that speaks about the record instead of the world
(propos*, establish*, canon, unknown, unresolved, confirm*, and "the
reading", "this page", "the source"), then each line about what people do not know (not know, no one,
nobody) so you can check the page states the truth they lack.

Examples:
  scripts/check-world-voice wiki/entities/npc/sabine-corvo.md
  scripts/check-world-voice outputs/wiki/entities/place/*.md
Frontmatter is skipped. Exit: 0 no record-voice hits; 1 hits to rewrite
(each as a world fact, or cut); 2 bad arguments.
"""
import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))
from tools.wiki_ops.cli import AgentParser, usage_error

RECORD = re.compile(r"\b(propos\w*|establish\w*|canon\w*|unknown|unresolved|confirm\w*"
                    r"|(?:this|that|the|one|another) reading|(?:this|the|that|its) page|(?:the|this|its|no) sources?)\b", re.I)  # reading/page/source only in their record sense, not "reading the seals"
IGNORANCE = re.compile(r"\b(not know|no one|nobody)\b", re.I)


def body(text: str) -> list[tuple[int, str]]:
    lines = text.splitlines()
    start = 0
    if lines and lines[0].strip() == "---":
        end = next((i for i, line in enumerate(lines[1:], 1) if line.strip() == "---"), 0)
        start = end + 1
    return [(i + 1, line) for i, line in enumerate(lines) if i >= start]


def main() -> int:
    ap = AgentParser(
        description=__doc__,
        example="scripts/check-world-voice wiki/entities/npc/sabine-corvo.md",
    )
    ap.add_argument("pages", nargs="+", type=Path)
    paths = ap.parse_args().pages
    hits = 0
    for path in paths:
        if not path.is_file():
            return usage_error(
                f"{path}: not a file",
                hint="pass existing markdown pages",
                example="scripts/check-world-voice wiki/entities/npc/sabine-corvo.md",
                list_valid="scripts/check-world-voice --help",
            )
        for n, line in body(path.read_text(encoding="utf-8")):
            text = re.sub(r"\[\[[^\]]*\]\]|!\[\[[^\]]*\]\]", "", line)  # link targets are not prose
            if m := RECORD.search(text):
                hits += 1
                print(f"{path}:{n}: rewrite as world fact ({m.group(0)}): {line.strip()}")
            elif m := IGNORANCE.search(text):
                print(f"{path}:{n}: state the truth they lack ({m.group(0)}): {line.strip()}")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
