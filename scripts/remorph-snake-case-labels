#!/usr/bin/env python3
"""Remorph DM-visible snake_case table Field labels to Title Case.

Table first-column / Field cells only (| one_thing | or | `one_thing` |).
YAML frontmatter keys unchanged. No lore rewrite. No wikilink target changes.
Does not remorph inside fenced code blocks. Map from --packet only (no invented labels).

Usage (repo root):
  ./scripts/remorph-snake-case-labels --packet PATH --dry-run
  ./scripts/remorph-snake-case-labels --packet PATH --apply
  ./scripts/remorph-snake-case-labels --packet PATH --json --dry-run
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

MAP_LINE = re.compile(r"^- `([^`]+)`\s*→\s*`([^`]+)`\s*$")
PACKET_PATH = re.compile(r"^- `([^`]+)`:")
# First cell: optional backticks around exact snake_case token
CELL = re.compile(
    r"^(\|\s*)(`?)([a-z][a-z0-9_]*)\2(\s*\|)(.*)$"
)


def parse_packet(packet: Path) -> tuple[dict[str, str], list[str]]:
    label_map: dict[str, str] = {}
    paths: list[str] = []
    for line in packet.read_text(encoding="utf-8").splitlines():
        s = line.strip()
        m = MAP_LINE.match(s)
        if m:
            label_map[m.group(1)] = m.group(2)
            continue
        p = PACKET_PATH.match(s)
        if p:
            paths.append(p.group(1))
    return label_map, paths


def remorph_text(text: str, label_map: dict[str, str]) -> tuple[str, list[dict[str, str]]]:
    changes: list[dict[str, str]] = []
    out: list[str] = []
    in_fence = False
    fence_marker: str | None = None

    for line in text.splitlines(keepends=True):
        raw = line.rstrip("\n")
        nl = "\n" if line.endswith("\n") else ""

        stripped = raw.lstrip()
        if stripped.startswith("```"):
            marker = stripped[:3]
            # toggle on matching fence open/close (``` … ```)
            if not in_fence:
                in_fence = True
                fence_marker = marker
            elif stripped.startswith(fence_marker or "```"):
                in_fence = False
                fence_marker = None
            out.append(line)
            continue

        if in_fence:
            out.append(line)
            continue

        m = CELL.match(raw)
        if not m:
            out.append(line)
            continue
        token = m.group(3)
        if token not in label_map:
            out.append(line)
            continue
        new_label = label_map[token]
        # Drop field-name backticks; Title Case is the DM-visible form
        new_line = f"{m.group(1)}{new_label}{m.group(4)}{m.group(5)}{nl}"
        changes.append({"from": token, "to": new_label})
        out.append(new_line)

    # Preserve trailing newline behavior of original when last line had none
    new_text = "".join(out)
    if text.endswith("\n") and not new_text.endswith("\n"):
        new_text += "\n"
    elif not text.endswith("\n") and new_text.endswith("\n") and changes:
        # keepends already handled; only strip if we added spuriously — don't
        pass
    return new_text, changes


def scan_path(repo: Path, rel: str, label_map: dict[str, str]) -> dict | None:
    path = repo / rel
    if not path.is_file():
        return {"path": rel, "missing": True, "changes": []}
    text = path.read_text(encoding="utf-8")
    _, changes = remorph_text(text, label_map)
    if not changes:
        return None
    return {"path": rel, "changes": changes}


def emit(data: object) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path("."), help="repo root (default .)")
    parser.add_argument("--packet", type=Path, required=True, help="ATE packet markdown")
    parser.add_argument("--json", action="store_true")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    args = parser.parse_args(argv)

    repo = args.repo.expanduser().resolve()
    if not repo.is_dir():
        print(f"missing repo: {repo}", file=sys.stderr)
        return 2

    packet = args.packet.expanduser().resolve()
    if not packet.is_file():
        print(f"missing packet: {packet}", file=sys.stderr)
        return 2

    label_map, paths = parse_packet(packet)
    if not label_map:
        print("no label map in packet", file=sys.stderr)
        return 2
    if not paths:
        print("no paths from packet", file=sys.stderr)
        return 2

    rows: list[dict] = []
    missing: list[str] = []
    label_count = 0
    for rel in paths:
        row = scan_path(repo, rel, label_map)
        if row is None:
            continue
        if row.get("missing"):
            missing.append(rel)
            continue
        rows.append(row)
        label_count += len(row["changes"])

    if args.dry_run:
        if args.json:
            emit(
                {
                    "would_change_pages": len(rows),
                    "would_change_labels": label_count,
                    "packet_pages": len(paths),
                    "map_size": len(label_map),
                    "missing": missing,
                    "pages": rows,
                }
            )
        else:
            print(f"would_change_pages\t{len(rows)}")
            print(f"would_change_labels\t{label_count}")
            print(f"packet_pages\t{len(paths)}")
            for row in rows:
                labs = "; ".join(f"{c['from']}→{c['to']}" for c in row["changes"])
                print(f"{row['path']}\t{labs}")
            for m in missing:
                print(f"MISSING\t{m}")
        return 0

    changed_pages: list[str] = []
    applied = 0
    missing = []
    for rel in paths:
        path = repo / rel
        if not path.is_file():
            missing.append(rel)
            continue
        text = path.read_text(encoding="utf-8")
        new, changes = remorph_text(text, label_map)
        if not changes:
            continue
        path.write_text(new, encoding="utf-8")
        changed_pages.append(rel)
        applied += len(changes)

    if args.json:
        emit(
            {
                "changed_pages": len(changed_pages),
                "changed_labels": applied,
                "packet_pages": len(paths),
                "missing": missing,
                "pages": changed_pages,
            }
        )
    else:
        print(f"changed_pages\t{len(changed_pages)}")
        print(f"changed_labels\t{applied}")
        for p in changed_pages:
            print(p)
        for m in missing:
            print(f"MISSING\t{m}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
