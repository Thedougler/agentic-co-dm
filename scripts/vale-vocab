#!/usr/bin/env python3
"""Refresh Vale's accepted proper-noun vocabulary from a wiki."""
from __future__ import annotations

import argparse
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from tools.creative_lint.vale_vocab import refresh_vocab


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--root", type=Path, default=ROOT)
parser.add_argument("--vault", type=Path, default=ROOT / "wiki")
args = parser.parse_args()

print(refresh_vocab(args.root.resolve(), args.vault.resolve()))
