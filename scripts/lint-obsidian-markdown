#!/usr/bin/env python3
"""Lint vault notes against obsidian-markdown hard rules.

Checks (FAIL unless noted):
  md_internal_link     — [text](….md) / relative .md path instead of [[wikilink]]
  title_only_frontmatter — frontmatter has title/date but no AGENTS `type` (entity dirs)
  dc_in_narration      — DC/numbers leak inside [!narration] callout
  forbidden_tree       — repo root has concepts/ · sources/ dirs (scaffold anti-pattern)
  broken_image_link    — [[attachments/…]] / ![[…]] image target missing on disk
  literal_backslash_n  — prose contains literal `\\n` instead of a real newline (outside fences/YAML)
  table_wikilink_unescaped_pipe — unescaped | inside [[...]] in a Markdown table cell

Also prints a reminder to run ./scripts/lint-statblocks for monster fences.

Skips: .agents/ .git/ .obsidian/ .qmd/ node_modules/ docs/ scripts/ specs/

Usage (repo root):
  ./scripts/lint-obsidian-markdown
  ./scripts/lint-obsidian-markdown --json
  ./scripts/lint-obsidian-markdown --strict   # also fail title_only (default: warn)
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
WIKI = ROOT / "wiki"

SKIP_PREFIXES = (
    ".agents/",
    ".git/",
    ".obsidian/",
    ".qmd/",
    ".omp/",
    ".specify/",
    ".venv/",
    "node_modules/",
    "docs/",
    "scripts/",
    "specs/",
)
SKIP_FILES = {"README.md", "README_TW.md", "AGENTS.md"}

ENTITY_PREFIXES = ("wiki/journal/", "wiki/templates/", "wiki/_raw/")
FORBIDDEN_DIRS = ("concepts", "sources")

MD_LINK = re.compile(
    r"(?<!!)\[([^\]]*)\]\((?!https?://)(?!mailto:)([^)]+\.md(?:#[^)]*)?)\)",
    re.I,
)
MD_LINK_PATH = re.compile(
    r"(?<!!)\[([^\]]*)\]\((?!https?://)(?!mailto:)((?:wiki|attachments)/[^)]+)\)",
    re.I,
)

FRONTMATTER = re.compile(r"^---\s*\n(.*?)\n---\s*\n", re.S)
TYPE_LINE = re.compile(r"^type:\s*\S+", re.M | re.I)
TITLE_OR_DATE = re.compile(r"^(title|date|created|updated):\s*", re.M | re.I)

FENCE = re.compile(r"```[\s\S]*?```")
LITERAL_N = re.compile(r"\\n")

NARRATION_BLOCK = re.compile(
    r">\s*\[!narration\][^\n]*\n(?:>(?:[^\n]*)\n)*",
    re.I,
)
DC_IN_TEXT = re.compile(
    r"\bDC\s*\d+\b|\bdifficulty class\b|\bpassive perception\s*\d+",
    re.I,
)

IMAGE_WIKI = re.compile(
    r"!?\[\[([^\]|#]+?\.(?:png|jpe?g|gif|webp|svg|pdf|mp3|mp4|webm))(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]",
    re.I,
)
WIKILINK = re.compile(
    r"!?\[\[(.*?)\]\]",
)
UNESCAPED_PIPE = re.compile(r"(?<!\\)\|")
TABLE_SEP = re.compile(r"^\s*\|[\s:|-]+\|\s*$")


def resolve_media(target: str) -> Path | None:
    target = target.strip().replace("\\", "/")
    candidates = [
        WIKI / target,
        WIKI / "attachments" / target,
        WIKI / "attachments" / Path(target).name,
    ]
    for c in candidates:
        if c.is_file():
            return c
    return None


def strip_fences(text: str) -> str:
    return FENCE.sub("\n", text)


def blank_fences(text: str) -> str:
    out: list[str] = []
    fence_len = 0
    for line in text.splitlines(keepends=True):
        stripped = line.lstrip()
        ticks = re.match(r"`{3,}", stripped)
        if ticks:
            n = len(ticks.group(0))
            if fence_len == 0:
                fence_len = n
                out.append("\n" if line.endswith("\n") else "")
                continue
            if n >= fence_len:
                fence_len = 0
                out.append("\n" if line.endswith("\n") else "")
                continue
        if fence_len:
            out.append("\n" if line.endswith("\n") else "")
        else:
            out.append(line)
    return "".join(out)


def iter_notes() -> list[Path]:
    out: list[Path] = []
    for path in WIKI.rglob("*.md"):
        rel = path.relative_to(ROOT).as_posix()
        if any(rel.startswith(p) for p in SKIP_PREFIXES):
            continue
        if path.name in SKIP_FILES:
            continue
        out.append(path)
    return sorted(out)


def check_forbidden_trees() -> list[dict]:
    findings = []
    for name in FORBIDDEN_DIRS:
        p = ROOT / name
        if p.is_dir():
            findings.append(
                {
                    "path": name + "/",
                    "status": "forbidden_tree",
                    "detail": f"parallel {name}/ tree — use wiki/ structure",
                }
            )
    return findings


def check_file(path: Path) -> list[dict]:
    rel = path.relative_to(ROOT).as_posix()
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    body = strip_fences(text)
    findings: list[dict] = []

    for m in MD_LINK.finditer(body):
        findings.append(
            {
                "path": rel,
                "status": "md_internal_link",
                "detail": f"[{m.group(1)}]({m.group(2)}) → use [[wikilink]]",
            }
        )
    for m in MD_LINK_PATH.finditer(body):
        target = m.group(2)
        if target.lower().endswith(".md") or ".md#" in target.lower():
            continue
        findings.append(
            {
                "path": rel,
                "status": "md_internal_link",
                "detail": f"[{m.group(1)}]({target}) → use [[wikilink]]",
            }
        )

    if any(rel.startswith(p) for p in ENTITY_PREFIXES):
        fm = FRONTMATTER.match(text)
        if fm:
            block = fm.group(1)
            if TITLE_OR_DATE.search(block) and not TYPE_LINE.search(block):
                findings.append(
                    {
                        "path": rel,
                        "status": "title_only_frontmatter",
                        "detail": "has title/date but no AGENTS type: — add type/campaign/visibility",
                    }
                )
        elif rel.startswith("wiki/journal/") and path.name != "hot.md":
            findings.append(
                {
                    "path": rel,
                    "status": "missing_frontmatter",
                    "detail": "no YAML frontmatter — add AGENTS type fields",
                }
            )

    for nb in NARRATION_BLOCK.finditer(text):
        chunk = nb.group(0)
        if DC_IN_TEXT.search(chunk):
            findings.append(
                {
                    "path": rel,
                    "status": "dc_in_narration",
                    "detail": "DC / difficulty in [!narration] — move to [!mechanic] or [!secret]-",
                }
            )

    for m in IMAGE_WIKI.finditer(body):
        target = m.group(1).strip()
        if resolve_media(target) is None:
            findings.append(
                {
                    "path": rel,
                    "status": "broken_image_link",
                    "detail": f"missing media target: {target} (expected under attachments/)",
                }
            )

    table_body = blank_fences(text)
    for i, line in enumerate(table_body.splitlines(), 1):
        stripped = line.lstrip()
        if not stripped.startswith("|"):
            continue
        if TABLE_SEP.match(stripped):
            continue
        for m in WIKILINK.finditer(line):
            inner = m.group(1)
            if not UNESCAPED_PIPE.search(inner):
                continue
            shown = m.group(0)
            if len(shown) > 80:
                shown = shown[:77] + "..."
            findings.append(
                {
                    "path": rel,
                    "status": "table_wikilink_unescaped_pipe",
                    "detail": (
                        f"line {i}: {shown} — write the alias/size pipe as \\| "
                        "so the table cell does not split"
                    ),
                }
            )

    if rel.startswith(".agents/"):
        return findings
    scanned = text
    fm_match = FRONTMATTER.match(scanned)
    if fm_match:
        scanned = (" " * len(fm_match.group(0))) + scanned[len(fm_match.group(0)):]
    scanned = FENCE.sub(lambda m: " " * len(m.group(0)), scanned)
    for m in LITERAL_N.finditer(scanned):
        line = text.count("\n", 0, m.start()) + 1
        findings.append(
            {
                "path": rel,
                "status": "literal_backslash_n",
                "detail": f"line {line}: literal \\n in prose — use a real newline (Wiki-UI); fences/YAML ok",
            }
        )

    return findings


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--strict",
        action="store_true",
        help="also fail title_only_frontmatter and missing_frontmatter",
    )
    args = ap.parse_args()

    findings = check_forbidden_trees()
    for path in iter_notes():
        findings.extend(check_file(path))

    warn_statuses = {"title_only_frontmatter", "missing_frontmatter"}
    if not args.strict:
        fails = [f for f in findings if f["status"] not in warn_statuses]
    else:
        fails = list(findings)

    if args.json:
        print(
            json.dumps(
                {"findings": findings, "failing": fails, "count": len(findings)},
                indent=2,
            )
        )
    else:
        print(f"obsidian-markdown findings: {len(findings)} (failing: {len(fails)})")
        for f in findings:
            tag = "FAIL" if f in fails else "warn"
            print(f"  [{tag}/{f['status']}] {f['path']}: {f['detail']}")
        if (ROOT / "scripts" / "lint-statblocks").exists():
            print("\nAlso run: ./scripts/lint-statblocks  # monster Fantasy Statblocks")
        if fails:
            print("Skill: .agents/skills/obsidian-markdown/")

    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
