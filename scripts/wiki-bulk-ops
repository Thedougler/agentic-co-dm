#!/usr/bin/env python3
"""Safe, idempotent bulk operations for an Obsidian wiki vault."""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from dataclasses import asdict, dataclass, field
from pathlib import Path
from typing import Callable, Iterable

SKIP_DIRS = {
    ".obsidian",
    "_archive",
    "_raw",
    "_readouts",
    "_meta",
    "templates",
    "attachments",
}
KEY_RE = re.compile(r"^[A-Za-z0-9_-]+$")
FM_LINE_RE = re.compile(r"^([A-Za-z0-9_-]+):([ \t]*)(.*?)(\r?\n)?$")
LINK_RE = re.compile(r"(!?\[\[([^\]|#]*)(#[^\]|]*)?(?:\|([^\]]*))?\]\])")
EMPTY_LINK_RE = re.compile(r"!?(?:\[\[)(?:[ \t]*(?:\]|\||#))")


class CLIError(Exception):
    """A user-facing validation error that should exit with status 1."""


@dataclass
class Change:
    line: int
    old: str
    new: str
    zone: str


@dataclass
class ChangeRecord:
    file: str
    changes: list[Change]
    skipped: bool = False
    skip_reason: str | None = None
    resolution: str | None = None
    candidates: list[str] | None = None


@dataclass
class OperationResult:
    command: str
    dry_run: bool
    files_scanned: int
    files_modified: int
    files_skipped: int
    total_changes: int
    records: list[ChangeRecord]
    details: dict[str, object] = field(default_factory=dict)

    def jsonable(self) -> dict:
        return asdict(self)

@dataclass(frozen=True)
class Frontmatter:
    start: int
    end: int
    body_start: int
    body_end: int
    lines: tuple[str, ...]


def parse_frontmatter(text: str) -> Frontmatter | None:
    """Return line indexes for a top-level ``---`` fenced block."""
    lines = tuple(text.splitlines(keepends=True))
    if not lines or lines[0].rstrip("\r\n") != "---":
        return None
    for index in range(1, len(lines)):
        if lines[index].rstrip("\r\n") == "---":
            return Frontmatter(0, index, 1, index, lines)
    return None


def parse_fields(text: str, fm: Frontmatter | None = None) -> dict[str, str]:
    fm = fm or parse_frontmatter(text)
    if fm is None:
        return {}
    fields: dict[str, str] = {}
    for line in fm.lines[fm.body_start : fm.body_end]:
        match = FM_LINE_RE.match(line)
        if match and not line.startswith((" ", "\t", "-")):
            fields[match.group(1)] = match.group(3).strip()
    return fields


def clean_scalar(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
        return value[1:-1]
    return value


def validate_key(key: str) -> None:
    if not KEY_RE.fullmatch(key):
        raise CLIError(f"invalid frontmatter key: {key!r}")


def resolve_vault(raw: str | None) -> Path:
    candidate = raw or os.environ.get("OBSIDIAN_VAULT_PATH") or "wiki"
    vault = Path(candidate).expanduser().resolve()
    if not vault.exists():
        raise CLIError(f"vault does not exist: {vault}")
    if not vault.is_dir():
        raise CLIError(f"vault is not a directory: {vault}")
    return vault


def is_skipped_path(relative: Path) -> bool:
    return bool(set(relative.parts) & SKIP_DIRS)


def iter_markdown(vault: Path, glob: str | None, directory: str | None) -> Iterable[Path]:
    if glob and directory:
        raise CLIError("--glob and --directory cannot be used together")
    if directory:
        root = (vault / directory).resolve()
        try:
            root.relative_to(vault)
        except ValueError as exc:
            raise CLIError("--directory must stay inside the vault") from exc
        if not root.exists():
            raise CLIError(f"directory does not exist: {directory}")
        if not root.is_dir():
            raise CLIError(f"directory is not a directory: {directory}")
    else:
        root = vault
    for path in sorted(root.rglob("*.md")):
        if not path.is_file():
            continue
        relative = path.relative_to(vault)
        if is_skipped_path(relative):
            continue
        if glob and not relative.match(glob):
            continue
        yield path


def read_utf8(path: Path, vault: Path) -> tuple[str | None, ChangeRecord | None]:
    relative = path.relative_to(vault).as_posix()
    try:
        return path.read_text(encoding="utf-8"), None
    except UnicodeDecodeError as exc:
        return None, ChangeRecord(relative, [], True, f"encoding error: {exc}")
    except OSError as exc:
        return None, ChangeRecord(relative, [], True, f"read error: {exc}")


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, raw_name = tempfile.mkstemp(prefix=f".{path.name}.", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(raw_name, path)
    except BaseException:
        try:
            os.unlink(raw_name)
        except FileNotFoundError:
            pass
        raise


def line_number(text: str, offset: int) -> int:
    return text.count("\n", 0, offset) + 1


def result_for(
    command: str,
    dry_run: bool,
    scanned: int,
    records: list[ChangeRecord],
    details: dict[str, object] | None = None,
) -> OperationResult:
    modified = sum(1 for record in records if record.changes and not record.skipped)
    skipped = sum(1 for record in records if record.skipped)
    changes = sum(len(record.changes) for record in records)
    return OperationResult(command, dry_run, scanned, modified, skipped, changes, records, details or {})


def emit(result: OperationResult, json_mode: bool, description: str) -> None:
    if json_mode:
        print(json.dumps(result.jsonable(), indent=2, sort_keys=True))
        return
    print(description)
    for record in result.records:
        if record.skipped:
            print(f"  {record.file} (skipped: {record.skip_reason})")
            continue
        for change in record.changes:
            print(f"  {record.file}:{change.line}  {change.old} → {change.new} [{change.zone}]")
    print(
        f"{result.files_scanned} files scanned, {result.files_modified} files modified, "
        f"{result.files_skipped} skipped, {result.total_changes} changes"
    )


def apply_content_plans(plans: dict[Path, str], dry_run: bool) -> None:
    if dry_run:
        return
    for path, text in plans.items():
        atomic_write(path, text)


def link_target_matches(target: str, old: str) -> bool:
    normalized = target[:-3] if target.endswith(".md") else target
    return normalized.rsplit("/", 1)[-1] == old


def rewrite_links(text: str, old: str, new: str) -> tuple[str, list[Change]]:
    changes: list[Change] = []

    def replace(match: re.Match[str]) -> str:
        whole, target, anchor, display = match.group(1), match.group(2), match.group(3) or "", match.group(4)
        if not link_target_matches(target, old):
            return whole
        suffix = ".md" if target.endswith(".md") else ""
        prefix = target.rsplit("/", 1)[0] + "/" if "/" in target else ""
        replacement_target = f"{prefix}{new}{suffix}"
        replacement = f"[[{replacement_target}{anchor}"
        if display is not None:
            replacement += f"|{display}"
        replacement += "]]"
        if whole.startswith("!"):
            replacement = "!" + replacement
        changes.append(Change(line_number(text, match.start()), whole, replacement, "wikilink"))
        return replacement

    return LINK_RE.sub(replace, text), changes


def title_rewrite(text: str, old_title: str | None, new_title: str) -> tuple[str, list[Change]]:
    fm = parse_frontmatter(text)
    if fm is None:
        return text, []
    lines = list(fm.lines)
    changes: list[Change] = []
    for index in range(fm.body_start, fm.body_end):
        match = FM_LINE_RE.match(lines[index])
        if not match or match.group(1) != "title" or lines[index].startswith((" ", "\t")):
            continue
        current = clean_scalar(match.group(3))
        if old_title is not None and current != old_title:
            return text, []
        newline = "\r\n" if lines[index].endswith("\r\n") else "\n" if lines[index].endswith("\n") else ""
        new_line = f"title:{match.group(2)}{new_title}{newline}"
        if new_line != lines[index]:
            changes.append(Change(index + 1, lines[index].rstrip("\r\n"), new_line.rstrip("\r\n"), "frontmatter"))
            lines[index] = new_line
        break
    return "".join(lines), changes

def link_stem(target: str) -> str:
    normalized = target[:-3] if target.endswith(".md") else target
    return normalized.rsplit("/", 1)[-1]


def parse_aliases(text: str) -> list[str]:
    fm = parse_frontmatter(text)
    if fm is None:
        return []
    aliases: list[str] = []
    lines = fm.lines
    for index in range(fm.body_start, fm.body_end):
        match = FM_LINE_RE.match(lines[index])
        if not match or match.group(1) != "aliases" or lines[index].startswith((" ", "\t")):
            continue
        raw = match.group(3).strip()
        if raw.startswith("[") and raw.endswith("]"):
            aliases.extend(clean_scalar(item.strip()) for item in raw[1:-1].split(",") if item.strip())
        elif not raw:
            next_index = index + 1
            while next_index < fm.body_end and re.match(r"^[ \t]+-\s*", lines[next_index]):
                aliases.append(clean_scalar(re.sub(r"^[ \t]+-\s*", "", lines[next_index]).strip()))
                next_index += 1
        break
    return [alias for alias in aliases if alias]


def existing_stems(vault: Path) -> set[str]:
    return {path.stem for path in iter_markdown(vault, None, None)}


def parse_mapping_file(raw_path: str, vault: Path) -> dict[str, str]:
    path = Path(raw_path).expanduser()
    if not path.is_absolute() and not path.exists():
        path = vault / path
    if not path.exists() or not path.is_file():
        raise CLIError(f"mapping file does not exist: {path}")
    mapping: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        raise CLIError(f"cannot read mapping file {path}: {exc}") from exc
    for number, line in enumerate(lines, 1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        columns = line.split("\t")
        if len(columns) != 2 or not all(column.strip() for column in columns):
            print(f"warning: skipping malformed mapping line {path}:{number}", file=sys.stderr)
            continue
        old, new = (column.strip() for column in columns)
        mapping[link_stem(old).casefold()] = link_stem(new)
    return mapping


def git_rename_mapping(vault: Path, stems: set[str]) -> dict[str, str]:
    try:
        completed = subprocess.run(
            ["git", "log", "--all", "--diff-filter=R", "--summary", "--name-status"],
            cwd=vault,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return {}
    if completed.returncode != 0:
        return {}
    mapping: dict[str, str] = {}
    pending_old: str | None = None
    for line in completed.stdout.splitlines():
        stripped = line.strip()
        match = re.match(r"^R\d*\s+(.+?)\s+(.+?)$", stripped)
        if match:
            old, new = Path(match.group(1)).stem, Path(match.group(2)).stem
            if new in stems:
                mapping[old.casefold()] = new
            continue
        match = re.match(r"^rename from (.+)$", stripped)
        if match:
            pending_old = Path(match.group(1)).stem
            continue
        match = re.match(r"^rename to (.+)$", stripped)
        if match and pending_old is not None:
            new = Path(match.group(1)).stem
            if new in stems:
                mapping[pending_old.casefold()] = new
            pending_old = None
    return mapping


def alias_mapping(vault: Path, stems: set[str]) -> dict[str, str]:
    mapping: dict[str, str] = {}
    for path in iter_markdown(vault, None, None):
        text, skipped = read_utf8(path, vault)
        if skipped or text is None:
            continue
        for alias in parse_aliases(text):
            mapping[link_stem(alias).casefold()] = path.stem
    return {old: new for old, new in mapping.items() if new in stems}


def levenshtein(left: str, right: str) -> int:
    previous = list(range(len(right) + 1))
    for row, left_char in enumerate(left, 1):
        current = [row]
        for column, right_char in enumerate(right, 1):
            current.append(min(current[-1] + 1, previous[column] + 1, previous[column - 1] + (left_char != right_char)))
        previous = current
    return previous[-1]


def resolve_link(
    old: str,
    stems: set[str],
    mappings: list[tuple[str, dict[str, str]]],
    fuzzy: bool,
    threshold: int,
) -> tuple[str | None, str, list[str]]:
    key = old.casefold()
    for source, mapping in mappings:
        candidate = mapping.get(key)
        if candidate and candidate in stems:
            return candidate, source, []
    if fuzzy:
        candidates = sorted(stem for stem in stems if levenshtein(old.casefold(), stem.casefold()) <= threshold)
        if len(candidates) == 1:
            return candidates[0], "fuzzy", []
        if candidates:
            return None, "ambiguous", candidates
    return None, "unresolved", []


def link_repair(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    if not 1 <= args.fuzzy_threshold <= 5:
        raise CLIError("--fuzzy-threshold must be between 1 and 5")
    stems = existing_stems(vault)
    mappings: list[tuple[str, dict[str, str]]] = []
    if args.mapping:
        mappings.append(("mapping", parse_mapping_file(args.mapping, vault)))
    if not args.no_git:
        mappings.append(("git", git_rename_mapping(vault, stems)))
    if not args.no_aliases:
        mappings.append(("alias", alias_mapping(vault, stems)))
    paths = list(iter_markdown(vault, args.glob, args.directory))
    records: list[ChangeRecord] = []
    plans: dict[Path, str] = {}
    ambiguous: list[str] = []
    unresolved: list[str] = []
    resolutions: list[dict[str, str]] = []
    for path in paths:
        text, skipped = read_utf8(path, vault)
        if skipped:
            records.append(skipped)
            continue
        assert text is not None
        targets = {link_stem(match.group(2)) for match in LINK_RE.finditer(text)}
        broken = sorted(target for target in targets if target not in stems)
        rewritten = text
        changes: list[Change] = []
        sources: set[str] = set()
        candidates: set[str] = set()
        for old in broken:
            new, source, suggestions = resolve_link(old, stems, mappings, not args.no_fuzzy, args.fuzzy_threshold)
            sources.add(source)
            if source == "ambiguous":
                ambiguous.append(old)
                candidates.update(suggestions)
                continue
            if source == "unresolved":
                unresolved.append(old)
                continue
            assert new is not None
            rewritten, link_changes = rewrite_links(rewritten, old, new)
            changes.extend(link_changes)
            resolutions.append({"file": path.relative_to(vault).as_posix(), "target": old, "new": new, "source": source})
        if changes:
            plans[path] = rewritten
        if changes or sources:
            records.append(
                ChangeRecord(
                    path.relative_to(vault).as_posix(),
                    changes,
                    resolution=",".join(sorted(sources)),
                    candidates=sorted(candidates) or None,
                )
            )
    result = result_for(
        "link-repair",
        args.dry_run,
        len(paths),
        records,
        {"resolutions": resolutions, "ambiguous": sorted(set(ambiguous)), "unresolved": sorted(set(unresolved))},
    )
    apply_content_plans(plans, args.dry_run)
    return result, "link-repair"


def rename(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    old, new = args.old, args.new
    if not old or not new or "/" in old or "/" in new or old == new:
        raise CLIError("rename names must be distinct non-empty file stems")
    paths = list(iter_markdown(vault, args.glob, args.directory))
    sources = [path for path in paths if path.stem == old]
    if len(sources) == 0:
        raise CLIError(f"old page not found: {old}.md")
    if len(sources) > 1:
        names = ", ".join(path.relative_to(vault).as_posix() for path in sources)
        raise CLIError(f"old page is ambiguous ({len(sources)} matches): {names}")
    source = sources[0]
    existing_destinations = [path for path in iter_markdown(vault, None, None) if path.stem == new]
    if existing_destinations:
        names = ", ".join(path.relative_to(vault).as_posix() for path in existing_destinations)
        raise CLIError(f"rename collision: destination stem already exists: {names}")
    destination = source.with_name(f"{new}.md")
    scanned = 0
    records_by_path: dict[Path, ChangeRecord] = {}
    plans: dict[Path, str] = {}
    for path in paths:
        scanned += 1
        text, skipped = read_utf8(path, vault)
        if skipped:
            records_by_path[path] = skipped
            continue
        assert text is not None
        rewritten, changes = rewrite_links(text, old, new)
        if path == source:
            target_title = args.new_title or new.replace("-", " ").title()
            rewritten, title_changes = title_rewrite(rewritten, args.old_title, target_title)
            changes += title_changes
        if changes:
            records_by_path[path] = ChangeRecord(path.relative_to(vault).as_posix(), changes)
            plans[path] = rewritten
    source_record = records_by_path.get(source)
    source_changes = source_record.changes if source_record else []
    source_changes.insert(0, Change(0, source.relative_to(vault).as_posix(), destination.relative_to(vault).as_posix(), "filename"))
    records_by_path[source] = ChangeRecord(destination.relative_to(vault).as_posix(), source_changes)
    if not args.dry_run:
        apply_content_plans(plans, False)
        os.replace(source, destination)
    records = [records_by_path[path] for path in paths if path in records_by_path]
    result = result_for("rename", args.dry_run, scanned, records)
    return result, f"rename: {old} → {new}"


def zone_spans(text: str) -> tuple[tuple[int, int], list[tuple[int, int]]]:
    fm = parse_frontmatter(text)
    frontmatter = (0, 0)
    if fm is not None:
        frontmatter = (0, sum(len(line) for line in fm.lines[: fm.end + 1]))
    links = [(match.start(2), match.end(2)) for match in LINK_RE.finditer(text)]
    return frontmatter, links


def replace_text(text: str, pattern: re.Pattern[str], replacement: str, include_frontmatter: bool, include_links: bool) -> tuple[str, list[Change]]:
    frontmatter, links = zone_spans(text)
    changes: list[Change] = []
    replacements: list[tuple[int, int, str, str]] = []

    def zone_for(start: int, end: int) -> str | None:
        if not include_frontmatter and frontmatter[1] and start < frontmatter[1] and end > frontmatter[0]:
            return None
        if not include_links and any(start < link_end and end > link_start for link_start, link_end in links):
            return None
        if frontmatter[0] <= start < frontmatter[1]:
            return "frontmatter"
        if any(link_start <= start < link_end for link_start, link_end in links):
            return "wikilink"
        return "body"

    for match in pattern.finditer(text):
        zone = zone_for(match.start(), match.end())
        if zone is None:
            continue
        old = match.group(0)
        new = match.expand(replacement) if pattern.groups else replacement
        if old == new:
            continue
        replacements.append((match.start(), match.end(), old, new))
        changes.append(Change(line_number(text, match.start()), old, new, zone))
    result = text
    for start, end, _old, new in reversed(replacements):
        result = result[:start] + new + result[end:]
    return result, changes


def replace(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    if args.search == "":
        raise CLIError("--search must not be empty")
    try:
        pattern = re.compile(args.search if args.regex else re.escape(args.search))
    except re.error as exc:
        raise CLIError(f"invalid regular expression: {exc}") from exc
    records: list[ChangeRecord] = []
    plans: dict[Path, str] = {}
    paths = list(iter_markdown(vault, args.glob, args.directory))
    for path in paths:
        text, skipped = read_utf8(path, vault)
        if skipped:
            records.append(skipped)
            continue
        assert text is not None
        rewritten, changes = replace_text(text, pattern, args.replacement, args.include_frontmatter, args.include_links)
        if rewritten != text:
            empty = EMPTY_LINK_RE.search(rewritten)
            if empty:
                raise CLIError(f"replacement would create an empty wikilink in {path.relative_to(vault)}:{line_number(rewritten, empty.start())}")
            records.append(ChangeRecord(path.relative_to(vault).as_posix(), changes))
            plans[path] = rewritten
    result = result_for("replace", args.dry_run, len(paths), records)
    apply_content_plans(plans, args.dry_run)
    return result, f"replace: {args.search} → {args.replacement}"


def parse_filters(raw_filters: list[str]) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for raw in raw_filters:
        if "=" not in raw:
            raise CLIError(f"filter must be KEY=VALUE: {raw!r}")
        key, value = raw.split("=", 1)
        validate_key(key)
        parsed[key] = value
    return parsed


def frontmatter_text_mutation(text: str, args: argparse.Namespace, filters: dict[str, str]) -> tuple[str, list[Change]]:
    fm = parse_frontmatter(text)
    if fm is None:
        return text, []
    fields = parse_fields(text, fm)
    if any(key not in fields or clean_scalar(fields[key]) != clean_scalar(value) for key, value in filters.items()):
        return text, []
    lines = list(fm.lines)
    changes: list[Change] = []
    indexes: dict[str, int] = {}
    for index in range(fm.body_start, fm.body_end):
        match = FM_LINE_RE.match(lines[index])
        if match and not lines[index].startswith((" ", "\t", "-")):
            indexes[match.group(1)] = index
    if args.action == "set":
        index = indexes.get(args.field)
        if index is None:
            newline = "\r\n" if lines[fm.end].endswith("\r\n") else "\n"
            new_line = f"{args.field}: {args.value}{newline}"
            insert_at = fm.end
            lines.insert(insert_at, new_line)
            changes.append(Change(insert_at + 1, "", new_line.rstrip("\r\n"), "frontmatter"))
        else:
            match = FM_LINE_RE.match(lines[index])
            assert match is not None
            newline = "\r\n" if lines[index].endswith("\r\n") else "\n" if lines[index].endswith("\n") else ""
            new_line = f"{args.field}:{match.group(2)}{args.value}{newline}"
            if new_line != lines[index]:
                changes.append(Change(index + 1, lines[index].rstrip("\r\n"), new_line.rstrip("\r\n"), "frontmatter"))
                lines[index] = new_line
    elif args.action == "rename":
        index = indexes.get(args.field)
        if index is not None:
            if args.new_field in indexes and args.new_field != args.field:
                raise CLIError(f"frontmatter rename collision: {args.new_field}")
            match = FM_LINE_RE.match(lines[index])
            assert match is not None
            new_line = f"{args.new_field}:{match.group(2)}{match.group(3)}{match.group(4) or ''}"
            changes.append(Change(index + 1, lines[index].rstrip("\r\n"), new_line.rstrip("\r\n"), "frontmatter"))
            lines[index] = new_line
    else:
        index = indexes.get(args.field)
        if index is not None:
            changes.append(Change(index + 1, lines[index].rstrip("\r\n"), "", "frontmatter"))
            del lines[index]
    return "".join(lines), changes


def frontmatter(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    validate_key(args.field)
    if args.action == "set" and args.value is None:
        raise CLIError("frontmatter set requires --value")
    if args.action == "rename":
        if not args.new_field:
            raise CLIError("frontmatter rename requires --new-field")
        validate_key(args.new_field)
    filters = parse_filters(args.filter)
    records: list[ChangeRecord] = []
    plans: dict[Path, str] = {}
    paths = list(iter_markdown(vault, args.glob, args.directory))
    for path in paths:
        text, skipped = read_utf8(path, vault)
        if skipped:
            records.append(skipped)
            continue
        assert text is not None
        rewritten, changes = frontmatter_text_mutation(text, args, filters)
        if changes:
            records.append(ChangeRecord(path.relative_to(vault).as_posix(), changes))
            plans[path] = rewritten
    result = result_for("frontmatter", args.dry_run, len(paths), records)
    apply_content_plans(plans, args.dry_run)
    return result, f"frontmatter: {args.action} {args.field}"

def clean_tag(raw: str) -> str:
    return clean_scalar(raw.strip().strip("`")).lstrip("#").strip()


def parse_taxonomy(text: str) -> tuple[set[str], dict[str, str]]:
    canonical: set[str] = set()
    aliases: dict[str, str] = {}
    section = ""
    for line in text.splitlines():
        heading = re.match(r"^#+\s+(.+?)\s*$", line)
        if heading:
            section = heading.group(1).casefold()
            continue
        cells = [clean_tag(cell) for cell in line.strip().strip("|").split("|")]
        if len(cells) >= 2 and cells[0].casefold() not in {"tag", "alias", "---"} and not all(set(cell) <= {"-", ":"} for cell in cells):
            first, second = cells[0], cells[1]
            if first and second and "alias" in section:
                target_match = re.search(r"(?:say|use)\s+([A-Za-z0-9_/-]+)", second, re.I)
                target = target_match.group(1) if target_match else second
                if target.casefold() not in {"use", "canonical"} and not target.startswith("("):
                    aliases[first.casefold()] = target
                    canonical.add(target)
            elif first and first.casefold() not in {"tag", "alias"}:
                canonical.add(first)
            continue
        bullet = re.match(r"^\s*[-*]\s+(.+?)\s*$", line)
        if bullet:
            value = bullet.group(1)
            if "alias" in section:
                arrow = re.split(r"\s+(?:->|=>|→)\s+|\s*:\s*", value, maxsplit=1)
            else:
                arrow = re.split(r"\s+(?:->|=>|→)\s+", value, maxsplit=1)
            if len(arrow) == 2:
                old, new = (clean_tag(item) for item in arrow)
                if old and new:
                    aliases[old.casefold()] = new
                    canonical.add(new)
            elif "alias" in section:
                value = clean_tag(value)
                if value:
                    aliases.setdefault(value.casefold(), value)
            else:
                value = clean_tag(value)
                if value:
                    canonical.add(value)
    return canonical, aliases


def taxonomy_path(raw_path: str | None, vault: Path) -> Path:
    path = Path(raw_path) if raw_path else vault / "_meta" / "taxonomy.md"
    if not path.is_absolute():
        candidate = vault / path
        path = candidate if candidate.exists() else path
    if not path.exists() or not path.is_file():
        raise CLIError(f"taxonomy file does not exist: {path}")
    try:
        path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise CLIError(f"cannot read taxonomy file {path}: {exc}") from exc
    return path


def tag_values(lines: list[str], fm: Frontmatter) -> tuple[str, int, int, list[str], str] | None:
    for index in range(fm.body_start, fm.body_end):
        match = FM_LINE_RE.match(lines[index])
        if not match or match.group(1) != "tags" or lines[index].startswith((" ", "\t")):
            continue
        raw = match.group(3).strip()
        if raw.startswith("[") and raw.endswith("]"):
            values = [clean_tag(item) for item in raw[1:-1].split(",") if item.strip()]
            return "inline", index, index + 1, values, match.group(2)
        if not raw:
            end = index + 1
            values: list[str] = []
            indent = "  "
            while end < fm.body_end:
                item = re.match(r"^([ \t]+)-\s*(.*?)\r?\n?$", lines[end])
                if not item:
                    break
                indent = item.group(1)
                values.append(clean_tag(item.group(2)))
                end += 1
            return "block", index, end, values, indent
    return None


def tag_normalize(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    taxonomy = taxonomy_path(args.taxonomy, vault)
    canonical, aliases = parse_taxonomy(taxonomy.read_text(encoding="utf-8"))
    known = {tag.casefold() for tag in canonical} | set(aliases)
    paths = list(iter_markdown(vault, args.glob, args.directory))
    records: list[ChangeRecord] = []
    plans: dict[Path, str] = {}
    unknown: set[str] = set()
    for path in paths:
        text, skipped = read_utf8(path, vault)
        if skipped:
            records.append(skipped)
            continue
        assert text is not None
        fm = parse_frontmatter(text)
        if fm is None:
            continue
        lines = list(fm.lines)
        parsed = tag_values(lines, fm)
        if parsed is None:
            continue
        mode, start, end, values, spacing = parsed
        normalized: list[str] = []
        seen: set[str] = set()
        for value in values:
            key = value.casefold()
            if key in aliases:
                value = aliases[key]
            elif key in known:
                value = next((tag for tag in canonical if tag.casefold() == key), value)
            else:
                unknown.add(value)
                if args.remove_unknown:
                    continue
            if value.casefold() not in seen:
                seen.add(value.casefold())
                normalized.append(value)
        if mode == "inline":
            original = lines[start]
            newline = "\r\n" if original.endswith("\r\n") else "\n" if original.endswith("\n") else ""
            match = FM_LINE_RE.match(original)
            assert match is not None
            replacement = f"tags:{spacing}[{', '.join(normalized)}]{newline}"
            if replacement != original:
                lines[start] = replacement
        else:
            original = "".join(lines[start:end])
            newline = "\r\n" if lines[start].endswith("\r\n") else "\n"
            replacement_lines = [lines[start]] + [f"{spacing}- {value}{newline}" for value in normalized]
            lines[start:end] = replacement_lines
            replacement = "".join(replacement_lines)
        rewritten = "".join(lines)
        if rewritten != text:
            changes = [Change(start + 1, original.rstrip("\r\n"), replacement.rstrip("\r\n"), "frontmatter")]
            records.append(ChangeRecord(path.relative_to(vault).as_posix(), changes))
            plans[path] = rewritten
    result = result_for("tag-normalize", args.dry_run, len(paths), records, {"unknown_tags": sorted(unknown)})
    apply_content_plans(plans, args.dry_run)
    return result, "tag-normalize"


def orphan_report(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    all_paths = list(iter_markdown(vault, None, None))
    candidates = list(iter_markdown(vault, args.glob, args.directory))
    incoming: set[str] = set()
    skipped_records: list[ChangeRecord] = []
    for path in all_paths:
        text, skipped = read_utf8(path, vault)
        if skipped:
            skipped_records.append(skipped)
            continue
        assert text is not None
        incoming.update(link_stem(match.group(2)) for match in LINK_RE.finditer(text))
    reserved = {"index.md", "log.md", "hot.md"}
    orphan_paths = [path.relative_to(vault).as_posix() for path in candidates if path.name not in reserved and path.stem not in incoming]
    records = skipped_records + [ChangeRecord(path, []) for path in orphan_paths]
    result = result_for("orphan-report", args.dry_run, len(all_paths), records, {"orphans": orphan_paths})
    return result, "orphan-report"
MOC_SKIP_DIRS = {
    ".obsidian",
    "_archive",
    "_raw",
    "_readouts",
    "_staging",
    "_meta",
    "attachments",
    "templates",
}

MOC_TITLE_MAP = {
    "concepts": "Concepts",
    "entities": "Entities",
    "journal": "Journal",
    "projects": "Projects",
    "references": "References",
    "skills": "Skills",
    "synthesis": "Synthesis",
    "npc": "Non-Player Characters",
    "pc": "Player Characters",
    "place": "Places",
    "faction": "Factions",
    "item": "Items",
    "creature": "Creatures",
    "vehicle": "Vehicles",
    "spell": "Spells",
    "lore": "Lore",
    "quest": "Quests",
    "region": "Regions",
    "sessions": "Sessions",
}


def moc_folder_title(name: str) -> str:
    return MOC_TITLE_MAP.get(name.casefold(), name.replace("-", " ").replace("_", " ").title())


def moc_folder_allowed(relative: Path) -> bool:
    return not any(part in MOC_SKIP_DIRS for part in relative.parts)


def moc_content_folders(vault: Path) -> list[Path]:
    folders: set[Path] = set()
    for path in vault.rglob("*.md"):
        relative = path.relative_to(vault)
        if not path.is_file() or path.parent == vault or not moc_folder_allowed(relative) or path.name == "_index.md":
            continue
        folders.add(path.parent)
    for path in vault.rglob("*"):
        if path.is_dir() and path != vault:
            relative = path.relative_to(vault)
            if moc_folder_allowed(relative) and any(child.is_dir() for child in path.iterdir()):
                folders.add(path)
    return sorted(folders, key=lambda item: item.relative_to(vault).as_posix())


def existing_title(text: str, fallback: str) -> str:
    value = parse_fields(text).get("title")
    return clean_scalar(value) if value else fallback


def moc_metadata(target: Path, vault: Path, title: str) -> tuple[str, str, str, str, str, str]:
    created = updated = "2026-09-17"
    if target.is_file():
        fields = parse_fields(target.read_text(encoding="utf-8"))
        created = clean_scalar(fields.get("created", created)) or created
        updated = clean_scalar(fields.get("updated", updated)) or updated
    relative = target.relative_to(vault)
    category = relative.parts[0] if relative.parts else ""
    return title, category, "[]", "[]", created, updated


def moc_destination(target: Path, vault: Path, staged: bool) -> Path:
    if not staged:
        return target
    relative = target.relative_to(vault)
    stage = vault / "_staging" / relative
    if target.exists():
        stage = stage.with_suffix(".patch.md")
    return stage


def moc_generated_text(folder: Path, vault: Path, existing: Path | None, content_folders: set[Path]) -> str:
    title = moc_folder_title(folder.name)
    metadata_target = existing or folder / "_index.md"
    title, category, tags, sources, created, updated = moc_metadata(metadata_target, vault, title)
    lines = [
        "---\n",
        f"title: {title}\n",
        f"category: {category}\n",
        f"tags: {tags}\n",
        f"sources: {sources}\n",
        f"created: {created}\n",
        f"updated: {updated}\n",
        "---\n",
        "\n",
    ]
    entries: list[tuple[str, str]] = []
    for page in sorted(folder.glob("*.md"), key=lambda item: item.name.casefold()):
        if page.name == "_index.md":
            continue
        text, skipped = read_utf8(page, vault)
        display = page.stem
        if not skipped and text is not None:
            display = existing_title(text, display)
        target = page.relative_to(vault).with_suffix("").as_posix()
        entries.append((display.casefold(), f"- [[{target}|{display}]]\n"))
    for child in sorted(folder.iterdir(), key=lambda item: item.name.casefold()):
        if not child.is_dir() or child not in content_folders:
            continue
        child_target = child.relative_to(vault).joinpath("_index").as_posix()
        child_title = moc_folder_title(child.name)
        entries.append((child_title.casefold(), f"- [[{child_target}|{child_title}]]\n"))
    for _sort_key, link in sorted(entries):
        lines.append(link)
    return "".join(lines)


def root_moc_links(vault: Path, folders: list[Path]) -> str:
    links = []
    for folder in folders:
        if len(folder.relative_to(vault).parts) != 1:
            continue
        title = moc_folder_title(folder.name)
        target = folder.relative_to(vault).joinpath("_index").as_posix()
        links.append((title.casefold(), f"- [[{target}|{title}]]\n"))
    return "".join(link for _key, link in sorted(links))


def moc_root_text(vault: Path, folders: list[Path]) -> str:
    root = vault / "index.md"
    original = root.read_text(encoding="utf-8") if root.exists() else ""
    marker = "## Folder Indexes\n"
    block = marker + root_moc_links(vault, folders)
    if marker in original:
        prefix = original.split(marker, 1)[0]
        return prefix + block
    separator = "\n" if original and not original.endswith("\n") else ""
    return original + separator + ("\n" if original else "") + block


def moc_generate(args: argparse.Namespace) -> tuple[OperationResult, str]:
    vault = resolve_vault(args.vault)
    folders = moc_content_folders(vault)
    content_folders = set(folders)
    staged = os.environ.get("WIKI_STAGED_WRITES", "").casefold() == "true"
    records: list[ChangeRecord] = []
    plans: dict[Path, str] = {}
    for folder in folders:
        target = folder / "_index.md"
        staged_target = moc_destination(target, vault, staged)
        existing = staged_target if staged_target.exists() else target if target.exists() else None
        try:
            old_text = existing.read_text(encoding="utf-8") if existing else ""
        except (OSError, UnicodeDecodeError) as exc:
            records.append(ChangeRecord(staged_target.relative_to(vault).as_posix(), [], True, f"read error: {exc}"))
            continue
        new_text = moc_generated_text(folder, vault, existing if existing and existing == target else target if target.exists() else None, content_folders)
        if new_text != old_text:
            changes = [Change(1, old_text, new_text, "body")]
            records.append(ChangeRecord(staged_target.relative_to(vault).as_posix(), changes))
            plans[staged_target] = new_text
    root = vault / "index.md"
    root_text = moc_root_text(vault, folders)
    if root_text != (root.read_text(encoding="utf-8") if root.exists() else ""):
        records.append(ChangeRecord("index.md", [Change(1, root.read_text(encoding="utf-8") if root.exists() else "", root_text, "body")]))
        plans[root] = root_text
    result = result_for("moc-generate", args.dry_run, sum(1 for _ in iter_markdown(vault, args.glob, args.directory)), records)
    apply_content_plans(plans, args.dry_run)
    return result, "moc-generate"


def build_parser() -> argparse.ArgumentParser:
    class Parser(argparse.ArgumentParser):
        def error(self, message: str) -> None:
            raise CLIError(message)

    def add_common(parser: argparse.ArgumentParser, *, suppress_defaults: bool = False) -> None:
        default = argparse.SUPPRESS if suppress_defaults else None
        parser.add_argument("--vault", default=default)
        parser.add_argument("--dry-run", action="store_true", default=argparse.SUPPRESS if suppress_defaults else False)
        parser.add_argument("--json", action="store_true", default=argparse.SUPPRESS if suppress_defaults else False)
        parser.add_argument("--glob", default=default)
        parser.add_argument("--directory", default=default)

    parser = Parser(description=__doc__)
    add_common(parser)
    subparsers = parser.add_subparsers(dest="command", required=True, parser_class=Parser)
    rename_parser = subparsers.add_parser("rename")
    add_common(rename_parser, suppress_defaults=True)
    rename_parser.add_argument("--old", required=True)
    rename_parser.add_argument("--new", required=True)
    rename_parser.add_argument("--old-title")
    rename_parser.add_argument("--new-title")
    replace_parser = subparsers.add_parser("replace")
    add_common(replace_parser, suppress_defaults=True)
    replace_parser.add_argument("--search", required=True)
    replace_parser.add_argument("--replacement", required=True)
    replace_parser.add_argument("--regex", action="store_true")
    replace_parser.add_argument("--include-frontmatter", action="store_true")
    replace_parser.add_argument("--include-links", action="store_true")
    fm_parser = subparsers.add_parser("frontmatter")
    add_common(fm_parser, suppress_defaults=True)
    fm_parser.add_argument("--action", choices=("set", "rename", "remove"), required=True)
    fm_parser.add_argument("--field", required=True)
    fm_parser.add_argument("--value")
    fm_parser.add_argument("--new-field")
    fm_parser.add_argument("--filter", action="append", default=[])
    repair_parser = subparsers.add_parser("link-repair")
    add_common(repair_parser, suppress_defaults=True)
    repair_parser.add_argument("--mapping")
    repair_parser.add_argument("--no-git", action="store_true")
    repair_parser.add_argument("--no-aliases", action="store_true")
    repair_parser.add_argument("--no-fuzzy", action="store_true")
    repair_parser.add_argument("--fuzzy-threshold", type=int, default=2)
    tag_parser = subparsers.add_parser("tag-normalize")
    add_common(tag_parser, suppress_defaults=True)
    tag_parser.add_argument("--taxonomy")
    tag_parser.add_argument("--remove-unknown", action="store_true")
    moc_parser = subparsers.add_parser("moc-generate")
    add_common(moc_parser, suppress_defaults=True)
    orphan_parser = subparsers.add_parser("orphan-report")
    add_common(orphan_parser, suppress_defaults=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    try:
        args = build_parser().parse_args(argv)
        if args.command == "rename":
            result, description = rename(args)
        elif args.command == "replace":
            result, description = replace(args)
        elif args.command == "frontmatter":
            result, description = frontmatter(args)
        elif args.command == "link-repair":
            result, description = link_repair(args)
        elif args.command == "tag-normalize":
            result, description = tag_normalize(args)
        elif args.command == "moc-generate":
            result, description = moc_generate(args)
        else:
            result, description = orphan_report(args)
        emit(result, args.json, description)
        if args.command == "orphan-report":
            return 0
        return 2 if result.files_skipped else 0
    except CLIError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2




def self_check() -> None:
    pattern = re.compile(re.escape("old"))
    text = "---\ntitle: old\n---\n[[old]] old\n"
    changed, changes = replace_text(text, pattern, "new", False, False)
    assert changed == "---\ntitle: old\n---\n[[old]] new\n"
    assert len(changes) == 1 and changes[0].zone == "body"
    renamed, link_changes = rewrite_links("[[old|display]] ![[x/old#p]] old-kin", "old", "new")
    assert renamed == "[[new|display]] ![[x/new#p]] old-kin"
    assert len(link_changes) == 2
    assert parse_fields("---\ntype: npc\n---\n") == {"type": "npc"}
    with tempfile.TemporaryDirectory(prefix="wiki-bulk-self-check-rename-") as raw:
        vault = Path(raw)
        (vault / "old.md").write_text("---\ntitle: Old\n---\nold\n", encoding="utf-8")
        (vault / "source.md").write_text("[[old|display]]\n", encoding="utf-8")
        assert main(["rename", "--old", "old", "--new", "new", "--vault", str(vault)]) == 0
        assert (vault / "new.md").is_file() and not (vault / "old.md").exists()
        assert "[[new|display]]" in (vault / "source.md").read_text(encoding="utf-8")
        assert main(["frontmatter", "--action", "set", "--field", "reviewed", "--value", "true", "--vault", str(vault)]) == 0
        (vault / "entities").mkdir()
        (vault / "entities" / "entry.md").write_text("---\ntitle: Entry\n---\n", encoding="utf-8")
        assert main(["moc-generate", "--vault", str(vault)]) == 0
        assert (vault / "entities" / "_index.md").is_file()
    with tempfile.TemporaryDirectory(prefix="wiki-bulk-self-check-") as raw:
        vault = Path(raw)
        (vault / "target.md").write_text("target\n", encoding="utf-8")
        (vault / "source.md").write_text("[[old-target]]\n", encoding="utf-8")
        mapping = vault / "mapping.tsv"
        mapping.write_text("old-target\ttarget\n", encoding="utf-8")
        assert main(["link-repair", "--mapping", str(mapping), "--no-git", "--no-fuzzy", "--vault", str(vault)]) == 0
        assert (vault / "source.md").read_text(encoding="utf-8") == "[[target]]\n"
        taxonomy = vault / "taxonomy.md"
        taxonomy.write_text("# Tags\n- npc\n## Aliases\n- person -> npc\n", encoding="utf-8")
        (vault / "tagged.md").write_text("---\ntags: [person, npc]\n---\nbody\n", encoding="utf-8")
        assert main(["tag-normalize", "--taxonomy", str(taxonomy), "--vault", str(vault)]) == 0
        assert "tags: [npc]" in (vault / "tagged.md").read_text(encoding="utf-8")
        assert main(["orphan-report", "--vault", str(vault)]) == 0


if __name__ == "__main__":
    if len(sys.argv) == 1:
        self_check()
    else:
        raise SystemExit(main())
