#!/usr/bin/env python3
"""Run one Luna 6 (Codex CLI) behavioral test subject: a skill eval or any ad-hoc task.

Policy (who grades, dispatch all at once, re-run only failures, stop on usage
limit): CLAUDE.md § Behavioral Test Subject. This script owns the Codex command.

  # a skill eval: prompt, inputs, and outputs come from <skill>/evals/evals.json
  ./scripts/luna-eval --skill .agents/skills/session-beats --eval hook-from-plan \\
      --out session-beats-workspace/iteration-1

  # any task, with or without a skill (--no-skill or no --skill = baseline)
  ./scripts/luna-eval --task "Compose the Session 13 beats from ..." \\
      --skill .agents/skills/session-beats --name s13-beats --out scratch/luna

One call per subject, each in its own background shell. The subject never
touches the repo: every page it would create or edit is written under
<run>/outputs/ at its repo-relative path, beside response.md (what it would
say back) and process.md (every file and image it opened, every search).

Eval fields read from evals.json (all optional except id and prompt):
  prompt         the task
  files          input files the subject must use
  outputs        what to deliver, replacing the default description
  context        extra instructions appended to the prompt (constraints,
                 success criteria, scope)
  subject_skill  skill the subject runs, when it is not the skill that owns
                 the eval (e.g. a recap eval owned by theatre-of-the-mind but
                 run through session-recap)

Run layout: <out>/<name>/eval_metadata.json and
<out>/<name>/<config>/run-<n>/{outputs/, events.jsonl, final.txt, timing.json,
metrics.json}. metrics.json (data-model §3) comes from events.jsonl: tool calls,
retries, invocation_errors, tokens, completion_reason, model, effort, and
skills_read. When the eval has skill_selected assertions, luna-eval grades them
into grading.json (passes when the first SKILL.md read is that skill); the
skill-creator grader adds the other assertion types.

A rerun skips any run-<n>/ whose timing.json records exit 0, so after exit 3 or 5
only the missing runs are dispatched again (completed runs are kept).

Exit: 0 done (or already done); 2 bad arguments or eval; 3 usage-limit marker present (dispatch
nothing until the limit resets, then delete <out>/../CODEX_LIMIT); 4 subject
wrote no deliverable under outputs/; 5 this run hit the usage limit (every
Luna run was stopped).
"""
import argparse
import json
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from tools.wiki_ops.cli import repo_root  # noqa: E402

REPO = repo_root(Path(__file__).resolve().parent)
ASSERTION_TYPES = frozenset({
    "skill_selected", "behavior", "quality", "guardrail", "process", "content",
    "structure", "scope", "handoff", "coverage",
})
SCHEMA_EXAMPLE = '{"type":"behavior","text":"…"}'
DEFAULT_OUTPUTS = (
    "Write every page or file you would create or edit under {outputs}/ at its "
    "repo-relative path (for example {outputs}/wiki/journal/sessions/<campaign>/<NN>/<page>.md), "
    "complete as you would file it. Write what you would say back to the requester in "
    "{outputs}/response.md."
)


def validate_evals(path: Path) -> list[str]:
    """Check a whole evals.json against data-model §2; return one problem per bad record."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        return [f"{path}: eval -: unreadable JSON ({exc})"]
    problems: list[str] = []
    skill_dir = path.parent.parent.name
    name = data.get("skill_name")
    records = data.get("evals")
    if not isinstance(records, list) or not records:
        return [f"{path}: eval -: missing or empty evals[]"]
    for record in records:
        rid = record.get("id", "?") if isinstance(record, dict) else "?"
        issues: list[str] = []
        if not isinstance(record, dict):
            problems.append(f"{path}: eval ?: record is not an object")
            continue
        if name is None:
            issues.append("missing skill_name")
        elif name != skill_dir:
            issues.append(f"skill_name '{name}' does not equal directory '{skill_dir}'")
        if "id" not in record or not record.get("prompt"):
            issues.append("missing id or prompt")
        if "expectations" in record:
            issues.append("leftover expectations[]; convert to assertions[]")
        assertions = record.get("assertions")
        if not isinstance(assertions, list) or not assertions:
            issues.append("missing or empty assertions[]")
        else:
            for item in assertions:
                if not isinstance(item, dict) or not str(item.get("text", "")).strip():
                    issues.append("assertion needs {type, text}")
                    continue
                kind = item.get("type")
                if kind not in ASSERTION_TYPES:
                    issues.append(f"assertion type '{kind}' is not one of {sorted(ASSERTION_TYPES)}")
                elif kind == "skill_selected" and not (REPO / ".agents" / "skills" / str(item["text"])).is_dir():
                    issues.append(f"skill_selected text '{item['text']}' is not a directory under .agents/skills/")
        problems.extend(f"{path}: eval {rid}: {issue}" for issue in issues)
    return problems


def load_eval(skill: Path, eval_id: str) -> dict:
    path = skill / "evals" / "evals.json"
    problems = validate_evals(path)
    if problems:
        error = {"status": "error", "error": problems[0], "hint": "see data-model §2", "example": SCHEMA_EXAMPLE}
        if len(problems) > 1:
            error["problems"] = problems
        print(json.dumps(error))
        for problem in problems:
            print(problem, file=sys.stderr)
        sys.exit(2)
    evals = json.loads(path.read_text())["evals"]
    found = next((e for e in evals if str(e.get("id")) == eval_id), None)
    if found is None:
        sys.exit(f"no eval '{eval_id}' in {path}")
    return found


def build_prompt(task: str, skill: Path | None, spec: dict, outputs: Path) -> str:
    lines = [f"Execute this task. Repo root: {REPO}.", ""]
    if skill:
        lines.append(f"- Skill: {skill} (read SKILL.md first and follow it, including every "
                     "reference and skill it points you to)")
    lines.append(f"- Task: {task}")
    lines.append("- Scope: do exactly what the task asks, read only what it needs, and stop as soon as its "
                 "deliverable is complete; leave everything outside the task as it is, except friction you hit: fix "
                 "that at its source as the AGENTS.md friction rule says, staged under outputs/ like any other change.")
    if spec.get("files"):
        lines.append("- Input files: " + ", ".join(spec["files"]))
    lines.append("- Outputs: " + (spec.get("outputs") or DEFAULT_OUTPUTS).replace("{outputs}", str(outputs)))
    lines.append(f"- Also write {outputs}/process.md: a plain ordered list of every file you "
                 "opened or searched for (image files included) and every shell search you ran.")
    lines.append(f"- Keep your working notes (anything a skill says to write in working notes: "
                 f"inventories, drafts, audits) in {outputs}/notes.md.")
    if spec.get("context"):
        lines.append(f"- Context: {spec['context']}")
    lines.append("- Staged files under outputs/ sit outside the vault, so `scripts/wiki lint` cannot check them; "
                 "lint only live vault pages, and only when the task calls for lint.")
    lines += ["", f"Do not modify anything in the repo outside {outputs}/. Paths above are exact."]
    return "\n".join(lines)


def hit_usage_limit(events: Path) -> bool:
    for line in events.read_text().splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") in ("error", "turn.failed") or e.get("item", {}).get("type") == "error":
            if re.search(r"usage limit|rate.?limit|quota|hit your", json.dumps(e), re.I):
                return True
    return False


# Commands whose usage errors count toward invocation_errors (FR-027; data-model §3).
FR027 = re.compile(r"(?:^|[\s/;&|(])scripts/(?:wiki|wiki-lint|luna-eval|error-ledger\.py|manifest\.py)(?=\s|$)")
SKILL_MD = re.compile(r"(?:^|[\s'\"/=])((?:\.agents|\.claude|\.codex)/skills/[^/\s'\"]+/SKILL\.md)")
NOT_TOOLS = {"agent_message", "reasoning", "error", "todo_list"}


def _inner(command: str) -> str:
    """Strip Codex's shell wrapper: /bin/zsh -lc '<cmd>' -> <cmd>."""
    m = re.fullmatch(r"\S*sh -l?c '(.*)'", command, re.S)
    if m:
        return m.group(1).replace("'\\''", "'")
    m = re.fullmatch(r'\S*sh -l?c "(.*)"', command, re.S)
    return re.sub(r'\\(["\\$`])', r"\1", m.group(1)) if m else command


def _usage_error(output: str) -> bool:
    """FR-035 error object (status error + example) or argparse 'usage: … error:'."""
    for line in output.splitlines():
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("status") == "error" and "example" in obj:
            return True
    return bool(re.search(r"^usage: .*?^\S.*?error: ", output, re.M | re.S))


def build_metrics(events: Path, *, model: str, effort: str, exit_code: int, delivered: bool) -> dict:
    """Derive metrics.json from codex --json events; an absent event is null, never guessed."""
    items, usage = [], None
    for line in events.read_text().splitlines() if events.is_file() else []:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if e.get("type") == "item.completed" and e.get("item", {}).get("type") not in NOT_TOOLS:
            items.append(e["item"])
        elif e.get("type") == "turn.completed" and isinstance(e.get("usage"), dict):
            u = e["usage"]
            usage = usage or {"input": 0, "output": 0}
            usage["input"] += u.get("input_tokens", 0)
            usage["output"] += u.get("output_tokens", 0)
    tool_calls: dict[str, int] = {}
    retries = duplicates = 0
    errors: list[str] = []
    skills: list[str] = []
    last: dict[str, bool] = {}  # action key -> succeeded
    for it in items:
        kind = "command" if it["type"] == "command_execution" else it["type"]
        tool_calls[kind] = tool_calls.get(kind, 0) + 1
        if kind == "command":
            cmd = _inner(it.get("command", ""))
            ok = it.get("exit_code") == 0
            key = "cmd:" + cmd
            for path in SKILL_MD.findall(cmd):
                path = re.sub(r"^\.(claude|codex)/", ".agents/", path)
                if path not in skills:
                    skills.append(path)
            if not ok and FR027.search(cmd) and _usage_error(it.get("aggregated_output") or ""):
                errors.append(cmd)
        else:
            key, ok = f"{kind}:" + json.dumps(it.get("changes", it), sort_keys=True), it.get("status") != "failed"
        if key in last:
            retries += not last[key]
            duplicates += last[key]
        last[key] = ok
    reason = ("usage_limit" if hit_usage_limit(events) else "error" if exit_code != 0
              else "ok" if delivered else "no_output") if events.is_file() else "error"
    return {"tool_calls": tool_calls, "total_tool_calls": sum(tool_calls.values()), "retries": retries,
            "invocation_errors": len(errors), "invocation_error_commands": errors, "duplicate_actions": duplicates,
            "tokens": usage and {**usage, "total": usage["input"] + usage["output"]},
            "completion_reason": reason, "model": model, "effort": effort, "skills_read": skills}


def grade_skill_selected(assertions: list[dict], metrics: dict) -> list[dict]:
    """A skill_selected item passes when the first SKILL.md the subject read belongs to `text`."""
    first = (metrics.get("skills_read") or [None])[0]
    return [{"text": a["text"], "passed": bool(first) and first.split("/")[-2] == a["text"], "type": "skill_selected",
             "evidence": f"first SKILL.md read: {first}" if first else "no SKILL.md was read"}
            for a in assertions if a.get("type") == "skill_selected"]


EXAMPLE = "scripts/luna-eval --skill .agents/skills/place-design --eval 1 --out /tmp/pd/iteration-1"


class _Parser(argparse.ArgumentParser):
    """Report usage errors as the JSON error object (exit 2), plus the message on stderr."""

    def error(self, message: str) -> None:  # type: ignore[override]
        print(json.dumps({"status": "error", "error": message, "hint": "run scripts/luna-eval --help", "example": EXAMPLE}))
        print(f"luna-eval: error: {message}", file=sys.stderr)
        raise SystemExit(2)


def main() -> int:
    ap = _Parser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"Examples:\n  {EXAMPLE}\n  scripts/luna-eval --skill .agents/skills/place-design --eval 1 --config without_skill --no-skill --out /tmp/pd/iteration-1",
    )
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--eval", help="eval id in <skill>/evals/evals.json")
    src.add_argument("--task", help="free-form task text")
    src.add_argument("--task-file", type=Path, help="file holding the task text")
    ap.add_argument("--skill", type=Path, help="skill that owns --eval, and the subject's skill by default")
    ap.add_argument("--subject-skill", type=Path, help="skill the subject follows instead (e.g. a snapshot for old_skill)")
    ap.add_argument("--no-skill", action="store_true", help="subject gets no skill (without_skill baseline)")
    ap.add_argument("--out", type=Path, required=True, help="iteration dir, e.g. <skill>-workspace/iteration-3")
    ap.add_argument("--name", help="run name (default: the eval id)")
    ap.add_argument("--config", default="with_skill", help="with_skill, without_skill, old_skill, ...")
    ap.add_argument("--run", type=int, default=1, help="run number, for repeated runs")
    ap.add_argument("--context", help="extra instructions appended to the prompt")
    ap.add_argument("--model", default="gpt-6-luna")
    ap.add_argument("--effort", default="high", help="Codex reasoning effort for the subject (default: high)")
    a = ap.parse_args()

    spec: dict = {}
    if a.eval:
        if not a.skill:
            ap.error("--eval needs --skill (the skill whose evals.json holds it)")
        spec = load_eval(a.skill.resolve(), a.eval)
        task = spec["prompt"]
    else:
        if not a.name:
            ap.error("--task and --task-file need --name")
        task = a.task or a.task_file.read_text()
    # precedence: --no-skill, --subject-skill, the eval's subject_skill, --skill
    skill = (None if a.no_skill else a.subject_skill.resolve() if a.subject_skill
             else REPO / spec["subject_skill"] if spec.get("subject_skill")
             else a.skill.resolve() if a.skill else None)
    if a.context:
        spec["context"] = " ".join(filter(None, [spec.get("context"), a.context]))

    out = a.out.resolve()
    limit = out.parent / "CODEX_LIMIT"
    if limit.exists():
        print(f"usage-limit marker present: {limit}\n{limit.read_text()}")
        return 3
    name = a.name or str(spec["id"])
    run = out / name / a.config / f"run-{a.run}"
    timing = run / "timing.json"
    if timing.is_file():
        try:
            finished = json.loads(timing.read_text()).get("exit") == 0
        except ValueError:
            finished = False
        if finished:
            print(f"{name}: skip, {run} already completed (timing.json exit 0)")
            return 0
    outputs = run / "outputs"
    outputs.mkdir(parents=True, exist_ok=True)
    (out / name / "eval_metadata.json").write_text(json.dumps(
        {"eval_id": spec.get("id", name), "eval_name": name, "prompt": task,
         "assertions": spec.get("assertions", [])}, indent=1))

    prompt = build_prompt(task, skill, spec, outputs)
    (run / "prompt.txt").write_text(prompt)
    start = time.time()
    with open(run / "events.jsonl", "w") as ev, open(run / "stderr.txt", "w") as err:
        # Cold, lean subject: no Codex memories (none read, none written), no MCP servers (the
        # subject works from the repo and qmd), and high reasoning effort (the user's Codex
        # default is xhigh, which made each eval run 40+ minutes).
        lean = ["-c", "memories.use_memories=false", "-c", "memories.generate_memories=false",
                "-c", f"model_reasoning_effort={a.effort}"]
        for server in ("chrome-devtools", "node_repl", "context7"):  # plugin servers cannot be overridden
            lean += ["-c", f"mcp_servers.{server}.enabled=false"]
        rc = subprocess.run(["codex", "exec", "-m", a.model, "-s", "workspace-write", "-C", str(REPO), *lean,
                             "--skip-git-repo-check", "--json", "-o", str(run / "final.txt"), prompt],
                            stdout=ev, stderr=err, stdin=subprocess.DEVNULL).returncode
    secs = round(time.time() - start)
    (run / "timing.json").write_text(json.dumps(
        {"duration_ms": secs * 1000, "total_duration_seconds": secs, "exit": rc}))

    delivered = [p for p in outputs.rglob("*") if p.is_file() and p.name != "process.md"]
    metrics = build_metrics(run / "events.jsonl", model=a.model, effort=a.effort, exit_code=rc, delivered=bool(delivered))
    (run / "metrics.json").write_text(json.dumps(metrics, indent=1))
    selected = grade_skill_selected(spec.get("assertions", []), metrics)
    if selected:  # the grader (skill-creator agents/grader.md) adds the other types and carries these over
        (run / "grading.json").write_text(json.dumps({"expectations": selected}, indent=1))

    if metrics["completion_reason"] == "usage_limit":
        with open(limit, "a") as f:
            f.write(f"{datetime.now().isoformat()} {run}\n")
        subprocess.run(["pkill", "-f", f"codex exec -m {a.model}"])
        print(f"Codex usage limit: stopped every Luna run; marker at {limit}")
        return 5
    if not delivered:
        print(f"{name}: nothing under {outputs} (check final.txt for a misplaced path)")
        return 4
    print(f"{name} done in {secs}s: " + ", ".join(str(p.relative_to(outputs)) for p in delivered))
    return 0


if __name__ == "__main__":
    sys.exit(main())
