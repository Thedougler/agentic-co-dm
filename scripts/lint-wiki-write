#!/usr/bin/env python3
"""Run the repository lint surface after a wiki write.

The creative-lint file command is the replacement surface; legacy checks remain
as compatibility diagnostics until their literal-newline rules are ported.
Does not git commit, push, or resurrect after-write.

Usage (repo root):
  ./scripts/lint-wiki-write
  ./scripts/lint-wiki-write wiki/journal/sessions/shattered-sea/11
  ./scripts/lint-wiki-write --path wiki/journal/sessions/shattered-sea/11
  ./scripts/lint-wiki-write --json
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

SCRIPTS = Path(__file__).resolve().parent


def select_scope(path_option: Path | None, positional: Path | None) -> Path | None:
    if path_option is not None and positional is not None:
        if path_option.resolve() != positional.resolve():
            raise ValueError("--path and positional scope name different paths")
    selected = path_option or positional
    return selected.resolve() if selected is not None else None


def run_one(name: str, extra: list[str], as_json: bool) -> dict:
    cmd = [str(SCRIPTS / name)]
    if as_json:
        cmd.append("--json")
    cmd.extend(extra)
    proc = subprocess.run(cmd, capture_output=True, text=True)
    payload: dict | str
    if as_json:
        try:
            payload = json.loads(proc.stdout) if proc.stdout.strip() else {}
        except json.JSONDecodeError:
            payload = proc.stdout
    else:
        payload = proc.stdout
    return {
        "script": name,
        "exit": proc.returncode,
        "stdout": payload,
        "stderr": proc.stderr,
    }


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("scope", nargs="?", type=Path, help="Limit checks to a file or directory")
    parser.add_argument("--path", type=Path, help="Limit literal-newline lint to a file or directory")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    try:
        scope = select_scope(args.path, args.scope)
    except ValueError as exc:
        print(f"agentic-co-dm: {exc}", file=sys.stderr)
        return 2
    if scope is not None and not scope.exists():
        print(f"agentic-co-dm: path not found: {scope}", file=sys.stderr)
        return 2

    extra: list[str] = []
    if scope is not None:
        extra.extend(["--path", str(scope)])
    results = []
    creative_extra = ["file"]
    if scope is not None:
        creative_extra.append(str(scope))
    results.append(run_one("wiki-lint", creative_extra, args.json))
    results.append(run_one("lint-obsidian-markdown", extra, args.json))
    results.append(run_one("lint-literal-newlines", extra, args.json))

    code = 0
    for r in results:
        if r["exit"] != 0:
            code = r["exit"] if code == 0 else max(code, r["exit"])

    if args.json:
        print(json.dumps({"results": results, "exit": code}, indent=2, sort_keys=True))
        return code

    print(f"wiki-write: {len(results)} checks, exit {code}")
    for r in results:
        tag = "ok" if r["exit"] == 0 else f"fail {r['exit']}"
        print(f"== {r['script']} ({tag}) ==")
        if r["stdout"]:
            sys.stdout.write(r["stdout"] if r["stdout"].endswith("\n") else r["stdout"] + "\n")
        if r["stderr"]:
            sys.stderr.write(r["stderr"] if r["stderr"].endswith("\n") else r["stderr"] + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
