#!/usr/bin/env python3
"""Remorph shared-grammar heading Title Case / Connections / Secrets.

Heading lines only (H1–H3). No lore/body rewrite. Packet-scoped paths.

Map:
  At a glance → At a Glance (preserve level)
  At the table → At the Table (preserve level)
  Relationships / Related / Links / Ties → Connections (preserve level,
    then demote # Connections → ## Connections)
  Secrets & clues / Secrets (DM) → Secrets (preserve level)
  # Connections → ## Connections
  provenance / art (any wrong case) → Provenance / Art (preserve level)

Usage (repo root):
  ./scripts/remorph-shared-grammar --packet PATH --dry-run
  ./scripts/remorph-shared-grammar --paths-file PATH --apply
  ./scripts/remorph-shared-grammar --packet PATH --json --dry-run
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

HEADING = re.compile(r"(?m)^(#{1,3})([ \t]+)(.+?)[ \t]*$")
PACKET_LINE = re.compile(r"^- `([^`]+)` \([^)]+\):")

# Exact source title → target title (level preserved unless Connections H1 demote)
TITLE_MAP = {
    "At a glance": "At a Glance",
    "At the table": "At the Table",
    "Relationships": "Connections",
    "Related": "Connections",
    "Links": "Connections",
    "Ties": "Connections",
    "Secrets & clues": "Secrets",
    "Secrets (DM)": "Secrets",
}

TITLE_CASE_EXTRA = {
    "provenance": "Provenance",
    "art": "Art",
}


def parse_packet_paths(packet: Path) -> list[str]:
    paths: list[str] = []
    for line in packet.read_text(encoding="utf-8").splitlines():
        m = PACKET_LINE.match(line.strip())
        if m:
            paths.append(m.group(1))
    return paths


def parse_paths_file(path: Path) -> list[str]:
    out: list[str] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        out.append(s)
    return out


def map_heading(level: str, title: str) -> tuple[str, str] | None:
    """Return (new_level, new_title) if a remorph applies, else None."""
    new_title: str | None = None
    if title in TITLE_MAP:
        new_title = TITLE_MAP[title]
    else:
        low = title.lower()
        if low in TITLE_CASE_EXTRA and title != TITLE_CASE_EXTRA[low]:
            new_title = TITLE_CASE_EXTRA[low]

    new_level = level
    effective = new_title if new_title is not None else title

    # Demote bare H1 Connections (including after Relationships→Connections)
    if effective == "Connections" and new_level == "#":
        new_level = "##"
        new_title = "Connections"

    if new_title is None and new_level == level:
        return None
    if new_title is None:
        new_title = title
    if new_title == title and new_level == level:
        return None
    return new_level, new_title


def remorph_text(text: str) -> tuple[str, list[dict[str, str]]]:
    changes: list[dict[str, str]] = []

    def repl(m: re.Match[str]) -> str:
        level, sp, title = m.group(1), m.group(2), m.group(3)
        mapped = map_heading(level, title)
        if mapped is None:
            return m.group(0)
        new_level, new_title = mapped
        changes.append(
            {
                "from": f"{level} {title}",
                "to": f"{new_level} {new_title}",
            }
        )
        return f"{new_level}{sp}{new_title}"

    new = HEADING.sub(repl, text)
    return new, changes


def scan_path(repo: Path, rel: str) -> dict | None:
    path = repo / rel
    if not path.is_file():
        return {"path": rel, "missing": True, "changes": []}
    text = path.read_text(encoding="utf-8")
    _, changes = remorph_text(text)
    if not changes:
        return None
    return {"path": rel, "changes": changes}


def emit(data: object) -> None:
    print(json.dumps(data, indent=2, sort_keys=True))


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, default=Path("."), help="repo root (default .)")
    src = parser.add_mutually_exclusive_group(required=True)
    src.add_argument("--packet", type=Path, help="ATE packet markdown with `path` bullets")
    src.add_argument("--paths-file", type=Path, help="one repo-relative path per line")
    parser.add_argument("--json", action="store_true")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    args = parser.parse_args(argv)

    repo = args.repo.expanduser().resolve()
    if not repo.is_dir():
        print(f"missing repo: {repo}", file=sys.stderr)
        return 2

    if args.packet:
        paths = parse_packet_paths(args.packet.expanduser().resolve())
    else:
        paths = parse_paths_file(args.paths_file.expanduser().resolve())

    if not paths:
        print("no paths from packet/paths-file", file=sys.stderr)
        return 2

    rows: list[dict] = []
    missing: list[str] = []
    heading_count = 0
    for rel in paths:
        row = scan_path(repo, rel)
        if row is None:
            continue
        if row.get("missing"):
            missing.append(rel)
            continue
        rows.append(row)
        heading_count += len(row["changes"])

    if args.dry_run:
        if args.json:
            emit(
                {
                    "would_change_pages": len(rows),
                    "would_change_headings": heading_count,
                    "packet_pages": len(paths),
                    "missing": missing,
                    "pages": rows,
                }
            )
        else:
            print(f"would_change_pages\t{len(rows)}")
            print(f"would_change_headings\t{heading_count}")
            print(f"packet_pages\t{len(paths)}")
            for row in rows:
                heads = "; ".join(f"{c['from']} → {c['to']}" for c in row["changes"])
                print(f"{row['path']}\t{heads}")
            for m in missing:
                print(f"MISSING\t{m}")
        return 0

    changed_pages: list[str] = []
    applied_heads = 0
    for rel in paths:
        path = repo / rel
        if not path.is_file():
            missing.append(rel)
            continue
        text = path.read_text(encoding="utf-8")
        new, changes = remorph_text(text)
        if not changes:
            continue
        path.write_text(new, encoding="utf-8")
        changed_pages.append(rel)
        applied_heads += len(changes)

    if args.json:
        emit(
            {
                "changed_pages": len(changed_pages),
                "changed_headings": applied_heads,
                "packet_pages": len(paths),
                "missing": missing,
                "pages": changed_pages,
            }
        )
    else:
        print(f"changed_pages\t{len(changed_pages)}")
        print(f"changed_headings\t{applied_heads}")
        for p in changed_pages:
            print(p)
        for m in missing:
            print(f"MISSING\t{m}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
