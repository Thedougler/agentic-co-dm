#!/usr/bin/env python3
"""Fail if maintained agent files mention a missing or retired ./scripts command,
or cite a `scripts/…` or `tests/…` path that does not exist.

FR-049 / SC-031. Skills and AGENTS must name current tools only.
after-write is retired: a mention is a fail even if the file returns.

Usage (repo root):
  ./scripts/check-current-commands
  ./scripts/check-current-commands --json
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
RETIRED = frozenset({"after-write"})
CMD = re.compile(r"\./scripts/([A-Za-z0-9][A-Za-z0-9._-]*)(?![A-Za-z0-9._/-])")
PATH_REF = re.compile(r"(?<![A-Za-z0-9_./-])(?:\./)?((?:scripts|tests)/[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*)")
SCAN_ROOTS = (
    Path("AGENTS.md"),
    Path("wiki/AGENTS.md"),
    Path(".agents/skills"),
    Path("docs/agents"),
    Path("specs/026-agent-autonomy-scope"),
)
SKIP_PARTS = {".git", "evals"}


def iter_scan_files(root: Path) -> list[Path]:
    files: list[Path] = []
    for rel in SCAN_ROOTS:
        path = root / rel
        if path.is_file():
            files.append(path)
            continue
        if not path.is_dir():
            continue
        for p in path.rglob("*"):
            if not p.is_file():
                continue
            if any(part in SKIP_PARTS for part in p.parts):
                continue
            if p.suffix.lower() not in {".md", ".json"}:
                continue
            files.append(p)
    return sorted(files)


def script_exists(root: Path, name: str) -> bool:
    return (root / "scripts" / name).exists()


def scan(root: Path) -> list[dict]:
    hits: list[dict] = []
    seen: set[tuple[str, int, str]] = set()
    for path in iter_scan_files(root):
        text = path.read_text(encoding="utf-8")
        rel = path.relative_to(root).as_posix()
        for i, line in enumerate(text.splitlines(), 1):
            for m in CMD.finditer(line):
                name = m.group(1)
                if name == "scripts":
                    continue
                if name in RETIRED:
                    kind = "retired"
                elif not script_exists(root, name):
                    kind = "missing"
                else:
                    continue
                key = (rel, i, name)
                if key in seen:
                    continue
                seen.add(key)
                hits.append(
                    {
                        "path": rel,
                        "line": i,
                        "command": f"./scripts/{name}",
                        "kind": kind,
                    }
                )
            for m in PATH_REF.finditer(line):
                if m.group(0).startswith("./scripts/"):
                    continue  # covered by the command check above
                cited = m.group(1).rstrip(".")
                if "." not in cited.rsplit("/", 1)[-1] and cited.count("/") < 2:
                    continue  # prose such as "scripts/tools", not a cited file
                if (root / cited).exists():
                    continue
                key = (rel, i, cited)
                if key in seen:
                    continue
                seen.add(key)
                hits.append({"path": rel, "line": i, "command": cited, "kind": "missing"})
    return hits


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    root = args.root.resolve()
    hits = scan(root)
    if args.json:
        print(json.dumps({"hits": hits, "count": len(hits)}, indent=2, sort_keys=True))
    else:
        print(f"current-commands: {len(hits)} stale")
        for h in hits:
            print(f"  [{h['kind']}] {h['path']}:{h['line']} {h['command']}")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
