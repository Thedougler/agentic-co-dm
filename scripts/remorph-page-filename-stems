#!/usr/bin/env python3
"""Remorph wiki page basenames to match frontmatter title (title-stem standard).

Renames Path.stem → FM title, rewrites path-qualified wikilinks/embeds, leaves a
redirects_to stub at the old stem, and notes old stem as an alias on the live page.

Carve-outs (never renamed here): journal Session-*, redirects_to stubs, SKIP_DIRS,
attachments, reserved files. Does not invent lore or rewrite prose.

GATED: do not mass --apply on the live vault until Nick greenlights.
Prove --apply only on a temp vault copy.

Usage (repo root):
  ./scripts/remorph-page-filename-stems --dry-run [--wiki wiki]
  ./scripts/remorph-page-filename-stems --apply [--wiki wiki]
  ./scripts/remorph-page-filename-stems --dry-run --json
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import sys
from dataclasses import asdict, dataclass
from pathlib import Path

SKIP_DIRS = {
    ".obsidian",
    "_archive",
    "_archives",
    "_raw",
    "_readouts",
    "_meta",
    "templates",
    "attachments",
}
RESERVED = {"AGENTS.md", "index.md", "log.md", "hot.md"}
SESSION_STEM = re.compile(r"^Session-\d+", re.I)
ILLEGAL = re.compile(r'[/\\:*?"<>|\x00-\x1f]')
FM_BLOCK = re.compile(r"\A---\n(.*?)\n---\n?", re.DOTALL)
FM_TITLE = re.compile(r"^title:\s*(.*)$", re.MULTILINE)
FM_ALIASES_INLINE = re.compile(r"^aliases:\s*\[(.*?)\]\s*$", re.MULTILINE)
PATH_LINK = re.compile(
    r"(!?\[\[)"
    r"((?:wiki/)?"
    r"(?:entities|journal|concepts|synthesis|references|projects|misc|skills)/"
    r"[^\]|#]*?/)"
    r"([^\]|#/]+?)"
    r"((?:\.md)?(?:#[^\]|]*)?(?:\|[^\]]*)?\]\])"
)
BARE_LINK = re.compile(r"(!?)\[\[([^\]|#]+)((?:#[^\]|]*)?(?:\|[^\]]*)?)\]\]")


@dataclass
class Plan:
    src: str
    dest: str
    title: str
    stem: str
    reason: str = "title_stem"


def parse_fm(text: str) -> dict[str, str]:
    m = FM_BLOCK.match(text)
    if not m:
        return {}
    fields: dict[str, str] = {}
    for line in m.group(1).splitlines():
        item = re.match(r"^([A-Za-z_][\w-]*):\s*(.*)$", line)
        if item and not line.startswith((" ", "-")):
            fields[item.group(1)] = item.group(2).strip()
    return fields


def title_of(fields: dict[str, str]) -> str:
    return fields.get("title", "").strip().strip("\"'")


def illegal_stem(stem: str) -> bool:
    if ILLEGAL.search(stem) or stem != stem.strip() or "  " in stem:
        return True
    return any(ord(ch) < 32 for ch in stem)


def collect_plans(wiki: Path) -> tuple[list[Plan], list[str]]:
    plans: list[Plan] = []
    skips: list[str] = []
    for path in sorted(wiki.rglob("*.md")):
        rel = path.relative_to(wiki)
        if set(rel.parts) & SKIP_DIRS or path.name in RESERVED:
            continue
        if "_redirects" in rel.parts:
            continue
        text = path.read_text(encoding="utf-8")
        fields = parse_fm(text)
        if fields.get("redirects_to"):
            continue
        stem = path.stem
        if rel.parts and rel.parts[0] == "journal" and SESSION_STEM.match(stem):
            continue
        title = title_of(fields)
        if not title or title == stem:
            continue
        if illegal_stem(title):
            skips.append(f"{rel.as_posix()}: dest title has illegal basename chars")
            continue
        dest = (path.parent / f"{title}.md").relative_to(wiki).as_posix()
        plans.append(Plan(src=rel.as_posix(), dest=dest, title=title, stem=stem))
    return plans, skips


def collision_errors(wiki: Path, plans: list[Plan]) -> list[str]:
    errors: list[str] = []
    dest_counts: dict[str, int] = {}
    for p in plans:
        dest_counts[p.dest] = dest_counts.get(p.dest, 0) + 1
    for dest, n in dest_counts.items():
        if n > 1:
            errors.append(f"collision among plans: {dest} ({n})")
    planned_src = {p.src for p in plans}
    for p in plans:
        dest_path = wiki / p.dest
        if dest_path.exists() and p.dest not in planned_src:
            errors.append(f"dest exists: {p.dest} (from {p.src})")
    return errors


def add_alias(text: str, alias: str) -> str:
    """Ensure alias appears in frontmatter aliases (inline list or create)."""
    m = FM_BLOCK.match(text)
    if not m:
        return text
    block = m.group(1)
    if re.search(rf"(?m)^\s*-\s*{re.escape(alias)}\s*$", block) or re.search(
        rf"aliases:\s*\[[^\]]*?\b{re.escape(alias)}\b", block
    ):
        return text
    inline = FM_ALIASES_INLINE.search(block)
    if inline:
        inner = inline.group(1).strip()
        new_inner = f"{inner}, {alias}" if inner else alias
        new_block = FM_ALIASES_INLINE.sub(f"aliases: [{new_inner}]", block, count=1)
    elif re.search(r"(?m)^aliases:\s*$", block):
        new_block = re.sub(r"(?m)^aliases:\s*$", f"aliases:\n  - {alias}", block, count=1)
    elif FM_TITLE.search(block):
        new_block = FM_TITLE.sub(
            lambda mo: mo.group(0) + f"\naliases:\n  - {alias}", block, count=1
        )
    else:
        new_block = f"aliases:\n  - {alias}\n" + block
    rest = text[m.end() :]
    return "---\n" + new_block + "\n---\n" + rest.lstrip("\n")


def redirect_stub(old_stem: str, new_title: str, today: str) -> str:
    return (
        f"---\n"
        f"title: {old_stem}\n"
        f"redirects_to: \"[[{new_title}]]\"\n"
        f"category: entities\n"
        f"tags: []\n"
        f"sources: []\n"
        f"created: {today}\n"
        f"updated: {today}\n"
        f"---\n\n"
        f"# {old_stem}\n\n"
        f"Redirect → [[{new_title}]].\n"
    )


def rewrite_links(wiki: Path, stem_map: dict[str, str]) -> int:
    """Rewrite path-qualified + bare links whose target stem is an old stem."""
    if not stem_map:
        return 0
    changed = 0
    for path in sorted(wiki.rglob("*.md")):
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        text = path.read_text(encoding="utf-8")

        def path_repl(m: re.Match[str]) -> str:
            prefix, mid, seg, suffix = m.groups()
            new_stem = stem_map.get(seg)
            if not new_stem:
                return m.group(0)
            return f"{prefix}{mid}{new_stem}{suffix}"

        def bare_repl(m: re.Match[str]) -> str:
            bang, target, rest = m.groups()
            if "/" in target:
                return m.group(0)
            new_stem = stem_map.get(target)
            if not new_stem:
                return m.group(0)
            return f"{bang}[[{new_stem}{rest}]]"

        new_text, n1 = PATH_LINK.subn(path_repl, text)
        new_text, n2 = BARE_LINK.subn(bare_repl, new_text)
        if n1 or n2:
            path.write_text(new_text, encoding="utf-8")
            changed += 1
    return changed


def apply_plans(wiki: Path, plans: list[Plan]) -> dict:
    today = dt.date.today().isoformat()
    stem_map = {p.stem: p.title for p in plans}
    applied = []
    for p in plans:
        src = wiki / p.src
        dest = wiki / p.dest
        text = add_alias(src.read_text(encoding="utf-8"), p.stem)
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(text, encoding="utf-8")
        src.write_text(redirect_stub(p.stem, p.title, today), encoding="utf-8")
        applied.append(asdict(p))
    link_files = rewrite_links(wiki, stem_map)
    return {"applied": applied, "link_files_rewritten": link_files}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--wiki", type=Path, default=Path("wiki"))
    parser.add_argument("--json", action="store_true")
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--dry-run", action="store_true")
    mode.add_argument("--apply", action="store_true")
    args = parser.parse_args(argv)

    wiki = args.wiki.expanduser()
    wiki = wiki.resolve() if wiki.is_absolute() else (Path.cwd() / wiki).resolve()
    if not wiki.is_dir():
        print(f"wiki not found: {wiki}", file=sys.stderr)
        return 2

    plans, skips = collect_plans(wiki)
    errors = collision_errors(wiki, plans)
    report: dict = {
        "wiki": str(wiki),
        "mode": "apply" if args.apply else "dry-run",
        "count": len(plans),
        "plans": [asdict(p) for p in plans],
        "skips": skips,
        "errors": errors,
        "gated": "Do not mass --apply on live vault until Nick greenlights.",
    }

    if args.apply:
        if errors:
            if args.json:
                print(json.dumps(report, indent=2, sort_keys=True))
            else:
                print(f"remorph-page-filename-stems: {len(plans)} plans, ERRORS={len(errors)}")
                for e in errors:
                    print(f"  ! {e}")
            return 1
        report["apply_result"] = apply_plans(wiki, plans)

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"remorph-page-filename-stems: {len(plans)} plans ({report['mode']})")
        for p in plans[:50]:
            print(f"  {p.src} → {p.dest}")
        if len(plans) > 50:
            print(f"  … {len(plans) - 50} more")
        for s in skips:
            print(f"  skip: {s}")
        for e in errors:
            print(f"  ! {e}")
        if args.apply:
            print(f"  link_files_rewritten={report['apply_result']['link_files_rewritten']}")
        print(report["gated"])
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
