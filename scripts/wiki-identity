#!/usr/bin/env python3
"""Resolve wiki page identity before repair or consolidation."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))
from tools.wiki_ops.cli import emit_json, resolve_vault
from tools.wiki_ops.identity import resolve_identity, scan_identities
from tools.wiki_ops.scope import parse_scope


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    resolve = sub.add_parser("resolve")
    resolve.add_argument("path_or_slug")
    resolve.add_argument("--vault")
    resolve.add_argument("--json", action="store_true")
    scan = sub.add_parser("scan")
    scan.add_argument("--scope")
    scan.add_argument("--vault")
    scan.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    try:
        vault = resolve_vault(args.vault)
        if args.command == "resolve":
            result = resolve_identity(vault, args.path_or_slug)
            payload = result.to_dict()
            code = 2 if result.status == "ambiguous" else 0
        else:
            scope = parse_scope(args.scope)
            if scope:
                scope.resolve(vault)
            results = scan_identities(vault, scope=scope)
            ambiguities = [item.to_dict() for item in results if item.status == "ambiguous"]
            payload = {
                "scanned": len(results),
                "resolved": sum(item.status == "resolved" for item in results),
                "ambiguous": len(ambiguities),
                "distinct": sum(item.status == "distinct" for item in results),
                "ambiguities": ambiguities,
            }
            code = 2 if ambiguities else 0
    except (OSError, ValueError) as exc:
        print(json.dumps({"status": "error", "error": str(exc)}, separators=(",", ":")), file=sys.stderr)
        return 1
    emit_json(payload)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
