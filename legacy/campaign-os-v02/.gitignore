# Audio recordings — raw session audio stays local by default
# (.gitattributes would LFS-track these IF audio is ever committed;
# default is don't commit it at all)
*.wav
*.mp3
*.m4a
content/campaign/*/episodes/*/audio/
# Exception: generated NPC dialogue clips are committed vault content (LFS-tracked)
!**/dialogue/*.mp3

# Obsidian workspace state — local UI state, not vault content
vault/.obsidian/workspace*
vault/.obsidian/app.json
vault/.obsidian/graph.json
vault/.obsidian/plugins/calendarium/data.json

# Built player site output (Quartz build artifact, not source)
site/public/

# Guardrails-kit migration/backup checkpoint files
CLAUDE.md.pre-migration-*
docs/guardrails/*.md.pre-migration-*
docs/guardrails/*.pre-kit.md

# Claude Code personal settings (untracked, machine-local)
.claude/settings.local.json

# Local env / secrets — never commit (.env.example is the safe template).
# Bare .env too: the global use-openrouter / use-replicate skills may write one.
.env
.env.local
.env*.local

# macOS
.DS_Store

# Python bytecode caches
__pycache__/
*.pyc

# Linter caches and root Node tooling (markdownlint-cli2 dev dep)
.ruff_cache/
/node_modules/

# wiki-cli's own findings cache — machine-local, mtime-keyed, rebuilds from
# a cold sweep (bench.py); never shared history.
/.wiki-cli/

# Imported third-party reference material — not project source
IMPORTS/

# Scratch/reference material outside the vault architecture — not project source
tmp/

# Local sweep-to-markdown known-failure cache (gitignored — machine-local
# perf cache, not shared history; see lib.mjs's FAILURE_CACHE_PATH comment)
.inbox-convert-failures.json

# Drop zone for material awaiting ingestion (inbox-ingest.md) — staging only,
# never shared history; ingested content lands in raw/ + vault/ instead.
# Anchored (leading /) so this doesn't also match utils/scripts/inbox/.
/inbox/

# Python build metadata (pip install -e regenerates it)
*.egg-info/

# Transient runtime flags/caches (session-scoped, never history)
.claude/canon-gate-open
.claude/.lint-sweep.summary
.claude/.lint-cache.json
.claude/.lint-fcache.json
.claude/.lint-sweep.lock
.claude/.qmd-embed.lock
.claude/.auto-drain.session
.scratch/

# dndsim evolve/tune scratch preview (evolve.py's stage_tuned_statblock;
# regenerated per run, promoted to a real target only via apply=True)
utils/dndsim/.scratch/

# Vale style packages fetched by `vale sync` (utils/scripts/lint-vale.mjs) are
# tracked, same as Readability/ and ai-tells/ already were: an untracked style
# package makes the lint unrunnable anywhere the sync has not been run, so a
# git worktree cannot lint or `npm run lint:bench` at all, and a perf or
# findings delta cannot be measured against an older commit. Regenerated by
# `vale sync`, so a resync shows up as an ordinary diff — never hand-edit a
# rule inside one (a resync overwrites it); exempt it in .vale.ini instead.

# withFrontmatterGuard's (prose-scope.mjs) ephemeral sibling copies — Vale's
# own TokenIgnores never reaches YAML front matter, so a wikilink-
# transformed copy is written next to any source file that needs it for the
# run and removed by cleanup() in the same run; only a killed process could
# leave one behind. Named `<original-stem>.vale-fm-<pid>-<uuid>.md` — the
# marker sits mid-name (stem prefix keeps a basename-anchored .vale.ini
# section glob matching the copy), so the pattern has no anchor either.
*.vale-fm-*.md

# Vale chunk copies — a large file is split into sibling chunks for the run
# and removed by the same run's cleanup; only a killed process leaves one.
# Each chunk sits at `.vale-chunk-<pid>-<uuid>-<index>/<original-basename>`:
# the marker moves to the enclosing directory so the copy keeps the original's
# exact basename and every basename-anchored .vale.ini section still matches
# it. The older flat form is still ignored so a pre-existing orphan stays
# untracked.
.vale-chunk-*/
*.vale-chunk-*.md

.claude/waves/
.jscpd-report/
.claude/.lint-bench.jsonl
.claude/.wiki-bench.jsonl
.claude/.context-cost.json

# Obsidian re-creates a stub here if the app opens the repo root instead of vault/.
# The real vault config lives at vault/.obsidian/.
/.obsidian/
