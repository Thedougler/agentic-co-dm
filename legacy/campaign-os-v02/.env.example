# Copy to .env.local (gitignored) and fill in the values you use. Everything
# here is optional — a subsystem only needs its own key(s), and an absent
# .env.local is fine (loaders fall back to the shell env / auto-detect).

# ElevenLabs API key — npc-voice skill (NPC dialogue audio generation).
ELEVENLABS_API_KEY=

# Hugging Face token — shattered-audio transcription/diarization models
# (record-session-audio pipeline).
HF_TOKEN=

# OpenRouter API key — LLM/image calls routed through the global
# use-openrouter skill.
OPENROUTER_API_KEY=

# OpenRouter image-model id — read by the global use-openrouter skill.
# No campaign-os script reads it directly.
OPENROUTER_IMAGE_MODEL=

# Repo root override. Optional — the shell scripts auto-detect this from
# their own location, so leave it blank unless your checkout lives somewhere
# other than the git working tree they're run from.
CAMPAIGN_ROOT=
