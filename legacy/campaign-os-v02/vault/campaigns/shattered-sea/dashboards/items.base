filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/items/")
    - 'type == "item"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Items"
    order:
      - file.name
      - form
      - rarity
      - attunement
      - status
      - touched
    groupBy:
      property: form
      direction: ASC
