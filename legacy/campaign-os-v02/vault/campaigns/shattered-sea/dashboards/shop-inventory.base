filters:
  and:
    - or:
        - file.inFolder("vault/campaigns/shattered-sea/items/")
        - file.inFolder("vault/srd/items/")
    - 'type == "item"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'
    - found_at.linksTo(this.file)

views:
  - type: table
    name: "Inventory"
    order:
      - file.name
      - form
      - value
      - rarity
      - attunement
      - status
    groupBy:
      property: form
      direction: ASC
