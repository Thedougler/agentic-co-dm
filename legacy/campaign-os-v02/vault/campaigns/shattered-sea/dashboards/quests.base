filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/quests/")
    - 'type == "quest"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Quests"
    order:
      - file.name
      - quest_status
      - status
      - touched
    groupBy:
      property: quest_status
      direction: ASC
