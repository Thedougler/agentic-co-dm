filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/pcs/")
    - 'type == "pc"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Party Combat"
    order:
      - file.name
      - ac
      - hp_max
      - init_mod
      - pp
      - speed
