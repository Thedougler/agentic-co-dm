filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/locations/")
    - 'type == "location"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Locations"
    order:
      - file.name
      - status
      - geography
      - tags
      - touched
    groupBy:
      property: status
      direction: ASC
