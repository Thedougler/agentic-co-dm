filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/npcs/")
    - 'type == "npc"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "NPCs"
    order:
      - file.name
      - location
      - role
      - status
      - tags
      - touched
    groupBy:
      property: location
      direction: ASC
  - type: table
    name: "Villains"
    filters:
      and:
        - 'role.contains("villain")'
    order:
      - file.name
      - location
      - status
      - touched
