filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/monsters/")
    - 'type == "monster"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Monsters"
    order:
      - file.name
      - subtype
      - status
      - tags
      - touched
    groupBy:
      property: status
      direction: ASC
