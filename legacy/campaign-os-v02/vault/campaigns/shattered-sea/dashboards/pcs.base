filters:
  and:
    - file.inFolder("vault/campaigns/shattered-sea/pcs/")
    - 'type == "pc"'
    - or:
        - 'campaigns.isEmpty()'
        - 'campaigns.contains("Shattered Sea")'

views:
  - type: table
    name: "Party"
    order:
      - file.name
      - player
      - class_levels
      - level
      - hp_max
      - ac
      - status
      - touched
  - type: table
    name: "By player"
    order:
      - player
      - file.name
      - class_levels
      - level
    groupBy:
      property: player
      direction: ASC
