{
  "devMode": false,
  "ignoreCodeBlockRestrictions": false,
  "preferredDateFormat": "YYYY-MM-DD",
  "firstWeekday": {
    "index": 1,
    "name": "Monday",
    "shortName": "Mo"
  },
  "syncInterval": 200,
  "enableJs": false,
  "viewFieldDisplayNullAsEmpty": false,
  "enableSyntaxHighlighting": true,
  "enableEditorRightClickMenu": true,
  "inputFieldTemplates": [],
  "buttonTemplates": [
    {
      "id": "begin-recording",
      "label": "⏺ Begin Session Recording",
      "style": "primary",
      "action": {
        "type": "command",
        "command": "obsidian-shellcommands:shell-command-recstart000"
      }
    },
    {
      "id": "end-recording",
      "label": "⏹ End Session",
      "style": "destructive",
      "action": {
        "type": "command",
        "command": "obsidian-shellcommands:shell-command-recstop0000"
      }
    },
    {
      "id": "run-moment",
      "label": "▶ Run Moment",
      "style": "primary",
      "action": {
        "type": "command",
        "command": "obsidian-shellcommands:shell-command-runscene00"
      }
    }
  ],
  "excludedFolders": [
    "_templates"
  ]
}